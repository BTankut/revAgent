# Copy to a host-only deployment env file and replace every placeholder.
# Never commit the populated file.

GATEWAY_IMAGE=ghcr.io/example/revagent-gateway:sha-replace-me
GATEWAY_PUBLIC_URL=https://gateway.example.invalid
GATEWAY_DOMAIN=gateway.example.invalid
ACME_EMAIL=ops@example.invalid

# DATABASE_URL must address the `postgres` service and use credentials matching
# the three Postgres values. URL-encode its password component.
DATABASE_URL=replace-with-a-postgresql-connection-url
POSTGRES_DB=revagent
POSTGRES_USER=revagent
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

LLM_PROVIDER_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=replace-with-provider-key
LOG_LEVEL=info

# Generic OIDC only. DP-5 selects the provider before Keycloak is added or an
# external provider is configured.
OIDC_ISSUER_URL=https://identity.example.invalid/realms/revagent
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

OBJECT_STORE_HOST_PATH=/opt/revagent/data/objects
POSTGRES_DATA_HOST_PATH=/opt/revagent/data/postgres
CADDY_DATA_HOST_PATH=/opt/revagent/data/caddy/data
CADDY_CONFIG_HOST_PATH=/opt/revagent/data/caddy/config

CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_BIND=0.0.0.0
CADDY_HTTPS_PORT=443
