# Copy to a host-only deployment env file and replace every placeholder.
# Never commit the populated file.

GATEWAY_IMAGE=ghcr.io/example/revagent-gateway:sha-replace-me
GATEWAY_PUBLIC_URL=https://gateway.revagent.app
GATEWAY_DOMAIN=gateway.revagent.app

# The Gateway uses only the non-owner `revagent_runtime` login created by the
# migration runner. The migration owner URL and runtime password are supplied
# to the one-shot migration command, never to the Gateway container.
DATABASE_URL=postgresql://revagent_runtime:replace-with-runtime-password@postgres:5432/revagent
DATABASE_MIGRATION_URL=postgresql://revagent_migrator:replace-with-migration-owner-password@postgres:5432/revagent
REVAGENT_APP_DATABASE_PASSWORD=replace-with-runtime-password
POSTGRES_DB=revagent
POSTGRES_USER=revagent_migrator
POSTGRES_PASSWORD=replace-with-migration-owner-password

# RES-23: the authorized ChatGPT/Codex Desktop client owns the Phase-1
# agentic loop. The Gateway receives no LLM provider/model/API-key setting.
LOG_LEVEL=info

# EU-10 tracks the recommended Keycloak-in-Compose selection while the Gateway
# consumes only these provider-neutral resource-server values.
OIDC_ISSUER_URL=https://gateway.revagent.app/identity/realms/revagent
OIDC_CLIENT_ID=revagent-north-mcp
OIDC_JWKS_URI=https://gateway.revagent.app/identity/realms/revagent/protocol/openid-connect/certs
KEYCLOAK_ADMIN_USERNAME=replace-with-bootstrap-admin-name
KEYCLOAK_ADMIN_PASSWORD=replace-with-url-safe-random-password

OBJECT_STORE_HOST_PATH=/opt/revagent/data/objects
POSTGRES_DATA_HOST_PATH=/opt/revagent/data/postgres
KEYCLOAK_DATA_HOST_PATH=/opt/revagent/data/keycloak
CADDY_DATA_HOST_PATH=/opt/revagent/data/caddy/data
CADDY_CONFIG_HOST_PATH=/opt/revagent/data/caddy/config

# Cloudflare Tunnel origin. Keep the bind loopback-only; the staged connector
# routes gateway.revagent.app to http://127.0.0.1:8081.
CADDY_ORIGIN_BIND=127.0.0.1
CADDY_ORIGIN_PORT=8081
