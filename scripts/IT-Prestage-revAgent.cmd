@echo off
setlocal EnableExtensions

set "POWERSHELL=%__APPDIR__%WindowsPowerShell\v1.0\powershell.exe"
set "REVAGENT_PRESTAGE_KIT_ROOT=%~dp0"
set "REVAGENT_PRESTAGE_DRIVER=%~dp0scripts\Invoke-RevAgentSupervisedPrestage.ps1"
set "REVAGENT_PRESTAGE_EVIDENCE=%~dp0scripts\New-RevAgentBootstrapPrestageEvidence.ps1"
set "REVAGENT_PRESTAGE_INTEGRITY=%~dp0installer\lib\RevAgent.DistributionIntegrity.psm1"
set "REVAGENT_PRESTAGE_TRUSTED_KEYS=%~dp0config\release-trusted-keys.json"
set "REVAGENT_PRESTAGE_DRIVER_SHA256=__REVAGENT_DRIVER_SHA256__"
set "REVAGENT_PRESTAGE_EVIDENCE_SHA256=__REVAGENT_EVIDENCE_SHA256__"
set "REVAGENT_PRESTAGE_INTEGRITY_SHA256=__REVAGENT_INTEGRITY_SHA256__"
set "REVAGENT_PRESTAGE_TRUSTED_KEYS_SHA256=__REVAGENT_TRUSTED_KEYS_SHA256__"
set "REVAGENT_PRESTAGE_STAGE_"

if not exist "%POWERSHELL%" (
  echo SECURITY STOP: canonical Windows PowerShell 5.1 was not found.
  exit /b 1
)
for %%F in ("%REVAGENT_PRESTAGE_DRIVER%" "%REVAGENT_PRESTAGE_EVIDENCE%" "%REVAGENT_PRESTAGE_INTEGRITY%" "%REVAGENT_PRESTAGE_TRUSTED_KEYS%") do if not exist "%%~fF" (
  echo revAgent supervised prestage kit member was not found: %%~fF
  exit /b 1
)

set "REVAGENT_LANGUAGE_MODE="
for /f "usebackq tokens=1,* delims==" %%P in (`^""%POWERSHELL%" -NoProfile -ExecutionPolicy Bypass -Command "$mode=$ExecutionContext.SessionState.LanguageMode; 'REVAGENT_LANGUAGE_MODE=' + $mode"^"`) do (
  if /i "%%P"=="REVAGENT_LANGUAGE_MODE" set "REVAGENT_LANGUAGE_MODE=%%Q"
)
if /i not "%REVAGENT_LANGUAGE_MODE%"=="FullLanguage" (
  echo revAgent supervised prestage cannot run: PowerShell is in %REVAGENT_LANGUAGE_MODE% mode.
  echo This is typically caused by Smart App Control or a WDAC/AppLocker policy on this machine.
  echo Ask IT to exempt/sign the revAgent prestage kit or disable Smart App Control, then retry.
  exit /b 78
)

"%POWERSHELL%" -NoProfile -ExecutionPolicy Bypass -Command "$identity=[Security.Principal.WindowsIdentity]::GetCurrent(); $admin=[Security.Principal.WindowsPrincipal]::new($identity).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator); if($admin){exit 0}else{exit 1}"
if not errorlevel 1 goto run_elevated

echo Requesting administrator approval for revAgent supervised prestage...
"%POWERSHELL%" -NoProfile -ExecutionPolicy Bypass -Command "try { $p=Start-Process -FilePath '%POWERSHELL%' -ArgumentList @('-NoLogo','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-EncodedCommand',$env:REVAGENT_PRESTAGE_STAGE_ENCODED) -WorkingDirectory $env:REVAGENT_PRESTAGE_KIT_ROOT -Verb RunAs -Wait -PassThru; exit [int]$p.ExitCode } catch { Write-Host ('Administrator approval or supervised prestage launch failed: ' + $_.Exception.Message); exit 79 }"
set "PRESTAGE_EXIT=%ERRORLEVEL%"
exit /b %PRESTAGE_EXIT%

:run_elevated
"%POWERSHELL%" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand %REVAGENT_PRESTAGE_STAGE_ENCODED%
set "PRESTAGE_EXIT=%ERRORLEVEL%"
if not "%PRESTAGE_EXIT%"=="0" echo revAgent supervised prestage failed with exit %PRESTAGE_EXIT%.
exit /b %PRESTAGE_EXIT%
