<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>revagent-bridge</AssemblyName>
    <RootNamespace>RevAgent.Bridge</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="jsoncanonicalizer" Version="1.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[8.0.29]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[2.1.12]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevAgent.Bridge.Bootstrap\RevAgent.Bridge.Bootstrap.csproj" />
    <ProjectReference Include="..\RevAgent.Contracts\RevAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\protocol\schemas\rbp\v1\common.schema.json"
      Link="ProtocolSchemas\common.schema.json"
      LogicalName="RevAgent.Bridge.ProtocolSchemas.common.schema.json" />
    <EmbeddedResource
      Include="..\..\..\protocol\schemas\rbp\v1\envelope.schema.json"
      Link="ProtocolSchemas\envelope.schema.json"
      LogicalName="RevAgent.Bridge.ProtocolSchemas.envelope.schema.json" />
    <EmbeddedResource
      Include="..\..\..\protocol\schemas\rbp\v1\payloads.schema.json"
      Link="ProtocolSchemas\payloads.schema.json"
      LogicalName="RevAgent.Bridge.ProtocolSchemas.payloads.schema.json" />
  </ItemGroup>
</Project>
