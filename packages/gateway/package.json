{
  "name": "@revagent/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run bundle:legacy && tsc -p tsconfig.json",
    "bundle:legacy": "node scripts/bundle-legacy-register.mjs",
    "lint": "eslint src scripts",
    "spike:benchmark": "node dist/transportSpikeBenchmarkCli.js",
    "spike:list-tools": "node dist/listToolsClientCli.js",
    "spike:server": "node dist/spikeServerCli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run bundle:legacy && npm run build --workspace @revagent/bridge-simulator && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "12.9.0",
    "csv-parse": "^6.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
