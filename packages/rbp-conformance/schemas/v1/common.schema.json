{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revagent.app/schemas/rbp-conformance/v1/common.schema.json",
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._{}\\-/]+$"
    },
    "hostPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "provenanceFileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "provenanceFileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digestSha256", "files"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256-stable-json-path-file-sha256/v1" },
        "digestSha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/provenanceFileRecord" }
        }
      }
    },
    "productionPackageContentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "packagePath", "contents", "nativeFiles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "packagePath": { "$ref": "#/definitions/hostPath" },
        "contents": { "$ref": "#/definitions/provenanceFileSet" },
        "nativeFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/provenanceFileRecord" }
        }
      }
    },
    "productionPackageContentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "packagePath", "fileCount", "filesSha256", "nativeFileCount", "nativeFilesSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "packagePath": { "$ref": "#/definitions/hostPath" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "filesSha256": { "$ref": "#/definitions/sha256" },
        "nativeFileCount": { "type": "integer", "minimum": 0 },
        "nativeFilesSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "installedRuntimeDependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "algorithm", "digestSha256", "roots", "resolutions", "packages"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "rbp-installed-runtime-closure/v1" },
        "algorithm": { "type": "string", "const": "sha256-stable-json-resolved-installed-runtime-closure/v1" },
        "digestSha256": { "$ref": "#/definitions/sha256" },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "packagePath"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "packagePath": { "$ref": "#/definitions/relativePath" }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requesterName", "requesterPath", "dependencyName", "dependencyRange", "kind", "status", "resolutionPath", "resolvedPackagePath", "resolvedVersion"],
            "properties": {
              "requesterName": { "type": "string", "minLength": 1 },
              "requesterPath": { "$ref": "#/definitions/relativePath" },
              "dependencyName": { "type": "string", "minLength": 1 },
              "dependencyRange": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["dependency", "optional_dependency", "peer_dependency", "optional_peer_dependency"] },
              "status": { "enum": ["installed", "workspace", "node_builtin", "absent_optional"] },
              "resolutionPath": {
                "anyOf": [
                  { "$ref": "#/definitions/relativePath" },
                  { "type": "string", "pattern": "^node:[A-Za-z0-9_./-]+$" },
                  { "type": "null" }
                ]
              },
              "resolvedPackagePath": {
                "anyOf": [
                  { "$ref": "#/definitions/relativePath" },
                  { "type": "null" }
                ]
              },
              "resolvedVersion": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "node_builtin" } } },
                "then": {
                  "properties": {
                    "resolutionPath": { "type": "string", "pattern": "^node:[A-Za-z0-9_./-]+$" },
                    "resolvedPackagePath": { "type": "null" },
                    "resolvedVersion": { "type": "null" }
                  }
                }
              },
              {
                "if": { "properties": { "status": { "const": "absent_optional" } } },
                "then": {
                  "properties": {
                    "resolutionPath": { "type": "null" },
                    "resolvedPackagePath": { "type": "null" },
                    "resolvedVersion": { "type": "null" }
                  }
                }
              }
            ]
          }
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/productionPackageContentIdentity" }
        }
      }
    },
    "installedBuildGeneratorDependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "algorithm", "digestSha256", "roots", "resolutions", "packages"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "rbp-installed-build-generator-closure/v1" },
        "algorithm": { "type": "string", "const": "sha256-stable-json-resolved-build-generator-closure/v1" },
        "digestSha256": { "$ref": "#/definitions/sha256" },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "packagePath"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "packagePath": { "$ref": "#/definitions/relativePath" }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requesterName", "requesterPath", "dependencyName", "dependencyRange", "kind", "status", "resolutionPath", "resolvedPackagePath", "resolvedVersion"],
            "properties": {
              "requesterName": { "type": "string", "minLength": 1 },
              "requesterPath": { "$ref": "#/definitions/relativePath" },
              "dependencyName": { "type": "string", "minLength": 1 },
              "dependencyRange": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["dependency", "optional_dependency", "peer_dependency", "optional_peer_dependency", "dev_dependency"] },
              "status": { "enum": ["installed", "workspace", "node_builtin", "absent_optional"] },
              "resolutionPath": {
                "anyOf": [
                  { "$ref": "#/definitions/relativePath" },
                  { "type": "string", "pattern": "^node:[A-Za-z0-9_./-]+$" },
                  { "type": "null" }
                ]
              },
              "resolvedPackagePath": {
                "anyOf": [
                  { "$ref": "#/definitions/relativePath" },
                  { "type": "null" }
                ]
              },
              "resolvedVersion": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "node_builtin" } } },
                "then": {
                  "properties": {
                    "resolutionPath": { "type": "string", "pattern": "^node:[A-Za-z0-9_./-]+$" },
                    "resolvedPackagePath": { "type": "null" },
                    "resolvedVersion": { "type": "null" }
                  }
                }
              },
              {
                "if": { "properties": { "status": { "const": "absent_optional" } } },
                "then": {
                  "properties": {
                    "resolutionPath": { "type": "null" },
                    "resolvedPackagePath": { "type": "null" },
                    "resolvedVersion": { "type": "null" }
                  }
                }
              }
            ]
          }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/productionPackageContentIdentity" }
        }
      }
    },
    "productionNodeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "realPath", "sha256", "version", "platform", "arch", "modulesAbi", "napiVersion"],
      "properties": {
        "path": { "$ref": "#/definitions/hostPath" },
        "realPath": { "$ref": "#/definitions/hostPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "modulesAbi": { "type": "string", "pattern": "^[0-9]+$" },
        "napiVersion": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "productionPowerShellIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "realPath", "sha256", "version"],
      "properties": {
        "path": { "$ref": "#/definitions/hostPath" },
        "realPath": { "$ref": "#/definitions/hostPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" }
      }
    },
    "productionToolchainIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildNode", "runtimeNode", "npmLauncher", "typescript", "git", "powershell"],
      "properties": {
        "buildNode": { "$ref": "#/definitions/productionNodeIdentity" },
        "runtimeNode": { "$ref": "#/definitions/productionNodeIdentity" },
        "npmLauncher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "realPath", "sha256", "package"],
          "properties": {
            "path": { "$ref": "#/definitions/hostPath" },
            "realPath": { "$ref": "#/definitions/hostPath" },
            "sha256": { "$ref": "#/definitions/sha256" },
            "package": { "$ref": "#/definitions/productionPackageContentIdentity" }
          }
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "entrypointPath", "entrypointSha256"],
          "properties": {
            "package": { "$ref": "#/definitions/productionPackageContentIdentity" },
            "entrypointPath": { "type": "string", "const": "node_modules/typescript/lib/tsc.js" },
            "entrypointSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "realPath", "sha256", "version"],
          "properties": {
            "path": { "$ref": "#/definitions/hostPath" },
            "realPath": { "$ref": "#/definitions/hostPath" },
            "sha256": { "$ref": "#/definitions/sha256" },
            "version": { "type": "string", "pattern": "^git version [0-9]+\\.[0-9]+\\.[0-9]+.*$" }
          }
        },
        "powershell": {
          "anyOf": [
            { "$ref": "#/definitions/productionPowerShellIdentity" },
            { "type": "null" }
          ]
        }
      }
    },
    "productionToolchainSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildNode", "runtimeNode", "npmLauncher", "typescript", "git", "powershell"],
      "properties": {
        "buildNode": { "$ref": "#/definitions/productionNodeIdentity" },
        "runtimeNode": { "$ref": "#/definitions/productionNodeIdentity" },
        "npmLauncher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "realPath", "sha256", "package"],
          "properties": {
            "path": { "$ref": "#/definitions/hostPath" },
            "realPath": { "$ref": "#/definitions/hostPath" },
            "sha256": { "$ref": "#/definitions/sha256" },
            "package": { "$ref": "#/definitions/productionPackageContentSummary" }
          }
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "entrypointPath", "entrypointSha256"],
          "properties": {
            "package": { "$ref": "#/definitions/productionPackageContentSummary" },
            "entrypointPath": { "type": "string", "const": "node_modules/typescript/lib/tsc.js" },
            "entrypointSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "realPath", "sha256", "version"],
          "properties": {
            "path": { "$ref": "#/definitions/hostPath" },
            "realPath": { "$ref": "#/definitions/hostPath" },
            "sha256": { "$ref": "#/definitions/sha256" },
            "version": { "type": "string", "pattern": "^git version [0-9]+\\.[0-9]+\\.[0-9]+.*$" }
          }
        },
        "powershell": {
          "anyOf": [
            { "$ref": "#/definitions/productionPowerShellIdentity" },
            { "type": "null" }
          ]
        }
      }
    },
    "manifestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "specVersion"],
      "properties": {
        "id": { "type": "string", "const": "rbp-v1.0-freeze-section-21" },
        "version": { "type": "string", "const": "1" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "specVersion": { "type": "string", "const": "1.0" }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "dirty"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commitSha": { "$ref": "#/definitions/gitSha" },
        "treeSha": { "$ref": "#/definitions/gitSha" },
        "dirty": { "type": "boolean", "const": false }
      }
    },
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "protocolVersion", "commitSha", "treeSha", "executableSha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "const": "1.0" },
        "commitSha": { "$ref": "#/definitions/gitSha" },
        "treeSha": { "$ref": "#/definitions/gitSha" },
        "executableSha256": { "$ref": "#/definitions/sha256" },
        "buildProvenance": { "$ref": "#/definitions/componentBuildProvenanceIdentity" }
      }
    },
    "componentBuildProvenanceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "buildContractVersion", "sidecarPath", "sidecarSha256", "compileInputsSha256", "buildGeneratorDependenciesSha256", "runtimeArtifactsSha256", "runtimeDependenciesSha256", "harnessArtifactsSha256", "harnessRuntimeDependenciesSha256", "toolchain"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "rbp-production-build-provenance/v3" },
        "buildContractVersion": { "type": "string", "const": "rbp-production-typescript-build/v3" },
        "sidecarPath": { "$ref": "#/definitions/relativePath" },
        "sidecarSha256": { "$ref": "#/definitions/sha256" },
        "compileInputsSha256": { "$ref": "#/definitions/sha256" },
        "buildGeneratorDependenciesSha256": { "$ref": "#/definitions/sha256" },
        "runtimeArtifactsSha256": { "$ref": "#/definitions/sha256" },
        "runtimeDependenciesSha256": { "$ref": "#/definitions/sha256" },
        "harnessArtifactsSha256": { "$ref": "#/definitions/sha256" },
        "harnessRuntimeDependenciesSha256": { "$ref": "#/definitions/sha256" },
        "toolchain": { "$ref": "#/definitions/productionToolchainSummary" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "workingDirectory", "environmentKeys", "readiness", "shutdown"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "workingDirectory": { "$ref": "#/definitions/relativePath" },
        "environmentKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "timeoutMs"],
          "properties": {
            "kind": { "enum": ["stdout_pattern", "tcp_loopback", "http_loopback", "process_alive"] },
            "value": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
          }
        },
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal", "timeoutMs"],
          "properties": {
            "signal": { "enum": ["SIGINT", "SIGTERM", "stdin_eof"] },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 }
          }
        }
      }
    },
    "componentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interfaceVersion", "expectedIdentity", "observedIdentity", "command", "process"],
      "properties": {
        "id": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] },
        "interfaceVersion": { "type": "string", "minLength": 1 },
        "expectedIdentity": { "$ref": "#/definitions/componentIdentity" },
        "observedIdentity": {
          "anyOf": [
            { "$ref": "#/definitions/componentIdentity" },
            { "type": "null" }
          ]
        },
        "command": { "$ref": "#/definitions/command" },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "startedAt", "readyAt", "stoppedAt", "exitCode"],
          "properties": {
            "pid": { "type": ["integer", "null"], "minimum": 1 },
            "startedAt": { "type": ["string", "null"], "format": "date-time" },
            "readyAt": { "type": ["string", "null"], "format": "date-time" },
            "stoppedAt": { "type": ["string", "null"], "format": "date-time" },
            "exitCode": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes", "mediaType"],
      "properties": {
        "kind": { "enum": ["run_report", "junit", "component_log", "wire_trace", "journal_snapshot", "leak_metrics", "aggregate_report", "aggregate_junit", "case_evidence", "soak_report", "soak_metrics"] },
        "path": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "leakCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openFileDescriptorDelta", "residentBytesDelta", "journalPendingDelta", "orphanProcessCount"],
      "properties": {
        "openFileDescriptorDelta": { "type": "integer" },
        "residentBytesDelta": { "type": "integer" },
        "journalPendingDelta": { "type": "integer" },
        "orphanProcessCount": { "type": "integer", "minimum": 0 }
      }
    },
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupSamples", "minimumMeasuredSamples", "maxResidentGrowthBytes", "maxResidentSlopeBytesPerSecond", "maxOpenFileDescriptorGrowth", "maxJournalPendingGrowth", "maxOrphanProcessCount"],
      "properties": {
        "warmupSamples": { "type": "integer", "const": 2 },
        "minimumMeasuredSamples": { "type": "integer", "const": 6 },
        "maxResidentGrowthBytes": { "type": "integer", "const": 67108864 },
        "maxResidentSlopeBytesPerSecond": { "type": "integer", "const": 2097152 },
        "maxOpenFileDescriptorGrowth": { "type": "integer", "const": 0 },
        "maxJournalPendingGrowth": { "type": "integer", "const": 0 },
        "maxOrphanProcessCount": { "type": "integer", "const": 0 }
      }
    },
    "resourceSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "offsetMs", "residentBytes", "openFileDescriptorCount", "journalPendingCount"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "offsetMs": { "type": "integer", "minimum": 0 },
        "residentBytes": { "type": "integer", "minimum": 0 },
        "openFileDescriptorCount": { "type": "integer", "minimum": 0 },
        "journalPendingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "resourceEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "measuredSampleCount", "residentGrowthBytes", "residentSlopeBytesPerSecond", "openFileDescriptorGrowth", "journalPendingGrowth", "orphanProcessCount", "passed"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "measuredSampleCount": { "type": "integer", "minimum": 0 },
        "residentGrowthBytes": { "type": "integer" },
        "residentSlopeBytesPerSecond": { "type": "integer" },
        "openFileDescriptorGrowth": { "type": "integer" },
        "journalPendingGrowth": { "type": "integer" },
        "orphanProcessCount": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "resourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "samplingMode", "sampleIntervalMs", "policy", "gcConfirmedComponents", "samples", "evaluation"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "rbp-resource-profile/v1" },
        "samplingMode": { "enum": ["bounded_slope", "post_gc"] },
        "sampleIntervalMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "policy": { "$ref": "#/definitions/resourcePolicy" },
        "gcConfirmedComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] }
        },
        "samples": { "type": "array", "items": { "$ref": "#/definitions/resourceSample" } },
        "evaluation": { "anyOf": [{ "$ref": "#/definitions/resourceEvaluation" }, { "type": "null" }] }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertionId", "subvectorId", "statement", "category", "passed", "expected", "actual", "observationIds", "evidenceSha256", "message"],
      "properties": {
        "assertionId": { "type": "string", "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)-[A-Z0-9-]+$" },
        "subvectorId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "statement": { "type": "string", "minLength": 1 },
        "category": { "enum": ["wire_behavior", "journal_truth", "execution_count", "authorization", "timing", "resource_leak", "artifact_integrity", "compatibility", "schema", "recovery", "transport_parity", "discovery", "safety"] },
        "passed": { "type": ["boolean", "null"] },
        "expected": {},
        "actual": {},
        "observationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" } },
        "evidenceSha256": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "message": { "type": ["string", "null"] }
      }
    },
    "bindingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "status", "durationMs"],
      "properties": {
        "binding": { "enum": ["wss", "streamable_http_sse"] },
        "status": { "enum": ["not_run", "running", "passed", "failed", "error", "skipped"] },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "title", "status", "startedAt", "finishedAt", "durationMs", "requiredComponents", "bindings", "assertions", "artifacts", "failure"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["not_run", "running", "passed", "failed", "error", "skipped"] },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "requiredComponents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] }
        },
        "bindings": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/bindingResult" } },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/assertion" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
        "failure": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 },
                "diagnostics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schemaVersion", "gatewayAudit", "bridgeTranscript"],
                  "properties": {
                    "schemaVersion": { "const": "rbp-real-trio-failure-diagnostics/v1" },
                    "gatewayAudit": {
                      "anyOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["sessionCount", "namespaces"],
                          "properties": {
                            "sessionCount": { "type": "integer", "minimum": 0 },
                            "namespaces": {
                              "type": "array",
                              "maxItems": 16,
                              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                            }
                          }
                        }
                      ]
                    },
                    "bridgeTranscript": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["stream", "at", "line"],
                        "properties": {
                          "stream": { "const": "stderr" },
                          "at": { "type": "string", "maxLength": 64 },
                          "line": { "type": "string", "minLength": 1, "maxLength": 512 }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
