{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revagent.app/schemas/rbp-conformance/v1/manifest.schema.json",
  "title": "RBP conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "manifestId", "manifestVersion", "spec", "requiredAggregateRuns", "requiredComponents", "retainedEvidence", "cases", "requiredAssertions"],
  "properties": {
    "$schema": { "type": "string", "const": "../schemas/v1/manifest.schema.json" },
    "schemaVersion": { "type": "string", "const": "rbp-conformance-manifest/v1" },
    "manifestId": { "type": "string", "const": "rbp-v1.0-freeze-section-21" },
    "manifestVersion": { "type": "string", "const": "1" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "section", "sourcePath"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "const": "1.0-rc.1" },
        "section": { "type": "string", "const": "21" },
        "sourcePath": { "type": "string", "const": "docs/specs/O1-bridge-gateway-protocol.md" }
      }
    },
    "requiredAggregateRuns": { "type": "integer", "const": 3 },
    "requiredComponents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "interfaceVersion"],
        "properties": {
          "id": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] },
          "interfaceVersion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retainedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "runReport", "junit", "componentLog", "wireTrace", "journalSnapshot", "caseEvidence", "leakMetrics", "aggregateReport", "aggregateJunit", "hashAlgorithm"],
      "properties": {
        "root": { "type": "string", "const": "artifacts/conformance/rbp-v1/1.0-rc.1" },
        "runReport": { "type": "string", "minLength": 1 },
        "junit": { "type": "string", "minLength": 1 },
        "componentLog": { "type": "string", "minLength": 1 },
        "wireTrace": { "type": "string", "minLength": 1 },
        "journalSnapshot": { "type": "string", "minLength": 1 },
        "caseEvidence": { "type": "string", "minLength": 1 },
        "leakMetrics": { "type": "string", "minLength": 1 },
        "aggregateReport": { "type": "string", "minLength": 1 },
        "aggregateJunit": { "type": "string", "minLength": 1 },
        "hashAlgorithm": { "type": "string", "const": "sha256" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "title", "requiredComponents", "bindings", "assertionCategories"],
        "properties": {
          "id": { "type": "string", "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)$" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 40 },
          "title": { "type": "string", "minLength": 1 },
          "requiredComponents": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] }
          },
          "bindings": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "enum": ["wss", "streamable_http_sse"] }
          },
          "assertionCategories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["wire_behavior", "journal_truth", "execution_count", "authorization", "timing", "resource_leak", "artifact_integrity", "compatibility", "schema", "recovery", "transport_parity", "discovery", "safety"]
            }
          }
        }
      }
    },
    "requiredAssertions": {
      "type": "object",
      "minProperties": 40,
      "maxProperties": 40,
      "propertyNames": { "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "subvectorId", "statement", "category", "expected"],
          "properties": {
            "id": { "type": "string", "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)-[A-Z0-9-]+$" },
            "subvectorId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "statement": { "type": "string", "minLength": 1 },
            "category": {
              "enum": ["wire_behavior", "journal_truth", "execution_count", "authorization", "timing", "resource_leak", "artifact_integrity", "compatibility", "schema", "recovery", "transport_parity", "discovery", "safety"]
            },
            "expected": { "const": true }
          }
        }
      }
    }
  }
}
