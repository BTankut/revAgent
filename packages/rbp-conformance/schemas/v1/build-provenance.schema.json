{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revagent.app/schemas/rbp-conformance/v1/build-provenance.schema.json",
  "title": "RBP production component build provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildContractVersion", "componentId", "source", "entrypoint", "compileInputs", "runtimeArtifacts", "toolchain"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "rbp-production-build-provenance/v1" },
    "buildContractVersion": { "type": "string", "const": "rbp-production-typescript-build/v1" },
    "componentId": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._{}\\-/]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "compileInputs": { "$ref": "#/definitions/fileSet" },
    "runtimeArtifacts": { "$ref": "#/definitions/fileSet" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "typescriptVersion", "typescriptEntrypointPath", "typescriptEntrypointSha256"],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "typescriptVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "typescriptEntrypointPath": { "type": "string", "const": "node_modules/typescript/lib/tsc.js" },
        "typescriptEntrypointSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "definitions": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._{}\\-/]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digestSha256", "files"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256-stable-json-path-file-sha256/v1" },
        "digestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/fileRecord" }
        }
      }
    }
  }
}
