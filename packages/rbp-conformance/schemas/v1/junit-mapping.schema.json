{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revagent.app/schemas/rbp-conformance/v1/junit-mapping.schema.json",
  "title": "RBP conformance JUnit mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "runId", "suiteName", "tests", "failures", "errors", "skipped", "durationMs", "cases"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "rbp-conformance-junit/v1" },
    "manifest": { "$ref": "common.schema.json#/definitions/manifestIdentity" },
    "runId": { "type": "string", "minLength": 1 },
    "suiteName": { "type": "string", "const": "RBP/1 section 21 v1.0 freeze" },
    "tests": { "type": "integer", "const": 40 },
    "failures": { "type": "integer", "minimum": 0, "maximum": 40 },
    "errors": { "type": "integer", "minimum": 0, "maximum": 40 },
    "skipped": { "type": "integer", "minimum": 0, "maximum": 40 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "className", "testName", "status", "durationMs", "failure"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^O1-C(?:0[1-9]|[1-3][0-9]|40)$" },
          "className": { "type": "string", "const": "revAgent.rbp.v1.section21" },
          "testName": { "type": "string", "minLength": 1 },
          "status": { "enum": ["not_run", "running", "passed", "failed", "error", "skipped"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "failure": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
