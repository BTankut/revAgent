{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revagent.app/schemas/rbp-conformance/v1/soak-report.schema.json",
  "title": "RBP reconnect and proxy churn soak report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "mode", "runId", "status", "source", "components", "startedAt", "finishedAt", "requestedDurationMs", "actualDurationMs", "cycles", "resources", "artifacts", "failure"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "rbp-reconnect-soak/v1" },
    "manifest": { "$ref": "common.schema.json#/definitions/manifestIdentity" },
    "mode": { "enum": ["smoke", "one_hour"] },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "status": { "enum": ["passed", "failed", "error"] },
    "source": { "$ref": "common.schema.json#/definitions/sourceIdentity" },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "interfaceVersion", "identity"],
        "properties": {
          "id": { "enum": ["gateway_stub", "bridge_simulator", "addin_loopback_fixture"] },
          "interfaceVersion": { "type": "string", "minLength": 1 },
          "identity": { "$ref": "common.schema.json#/definitions/componentIdentity" }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "requestedDurationMs": { "type": "integer", "minimum": 30000, "maximum": 3600000 },
    "actualDurationMs": { "type": "integer", "minimum": 0, "maximum": 3900000 },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycle", "binding", "startedAt", "finishedAt", "reconnects", "proxyChurns", "heartbeatAcks", "controlRoundTrips", "journalPending", "passed"],
        "properties": {
          "cycle": { "type": "integer", "minimum": 1 },
          "binding": { "enum": ["wss", "streamable_http_sse"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "reconnects": { "type": "integer", "minimum": 1 },
          "proxyChurns": { "type": "integer", "minimum": 1 },
          "heartbeatAcks": { "type": "integer", "minimum": 1 },
          "controlRoundTrips": { "type": "integer", "minimum": 1 },
          "journalPending": { "type": "integer", "minimum": 0 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "resources": { "$ref": "common.schema.json#/definitions/resourceProfile" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/artifact" } },
    "failure": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "one_hour" } } },
      "then": { "properties": { "requestedDurationMs": { "type": "integer", "const": 3600000 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "smoke" } } },
      "then": { "properties": { "requestedDurationMs": { "type": "integer", "maximum": 600000 } } }
    }
  ]
}
