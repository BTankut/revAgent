{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.revagent.local/addin-loopback/v1/json-rpc-response.schema.json",
  "title": "RevAgent add-in loopback JSON-RPC 2.0 response",
  "oneOf": [
    {
      "$ref": "#/$defs/successResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "successResponse": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "https://schemas.revagent.local/addin-loopback/v1/common.schema.json#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "required": [
            "resultContractVersion"
          ],
          "properties": {
            "resultContractVersion": {
              "const": 2
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "https://schemas.revagent.local/addin-loopback/v1/common.schema.json#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                -32700,
                -32600,
                -32601,
                -32602,
                -32603
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "data": true
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": -32700
                  }
                },
                "required": [
                  "code"
                ]
              }
            },
            "required": [
              "error"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      -32601,
                      -32602,
                      -32603
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              }
            },
            "required": [
              "error"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "$ref": "https://schemas.revagent.local/addin-loopback/v1/common.schema.json#/$defs/requestId"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
