{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.revagent.local/addin-loopback/v1/get-document-context.schema.json",
  "title": "RevAgent add-in loopback v1 get_document_context method",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/successResponse"
    },
    {
      "$ref": "https://schemas.revagent.local/addin-loopback/v1/json-rpc-response.schema.json#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "https://schemas.revagent.local/addin-loopback/v1/common.schema.json#/$defs/requestId"
        },
        "method": {
          "const": "get_document_context"
        },
        "params": {
          "type": "object",
          "maxProperties": 0
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": [
        "documentId",
        "title",
        "pathDigest",
        "isWorkshared",
        "isActive"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pathDigest": {
          "oneOf": [
            {
              "$ref": "https://schemas.revagent.local/addin-loopback/v1/common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "isWorkshared": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "activeView": {
      "type": "object",
      "required": [
        "documentId",
        "id",
        "name",
        "type",
        "level"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "resultContractVersion",
        "documentContextContractVersion",
        "capturedAtUtc",
        "revision",
        "cacheState",
        "unavailableReason",
        "documents",
        "activeDocumentId",
        "activeView",
        "disciplineHint"
      ],
      "properties": {
        "resultContractVersion": {
          "const": 2
        },
        "documentContextContractVersion": {
          "const": 1
        },
        "capturedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheState": {
          "enum": [
            "ready",
            "warming",
            "unavailable"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "documents": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "activeDocumentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "activeView": {
          "oneOf": [
            {
              "$ref": "#/$defs/activeView"
            },
            {
              "type": "null"
            }
          ]
        },
        "disciplineHint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cacheState": {
                "const": "ready"
              }
            },
            "required": [
              "cacheState"
            ]
          },
          "then": {
            "properties": {
              "unavailableReason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "unavailableReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "documents": {
                "type": "array",
                "maxItems": 0
              },
              "activeDocumentId": {
                "type": "null"
              },
              "activeView": {
                "type": "null"
              },
              "disciplineHint": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "activeDocumentId": {
                "type": "null"
              }
            },
            "required": [
              "activeDocumentId"
            ]
          },
          "then": {
            "properties": {
              "activeView": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "successResponse": {
      "allOf": [
        {
          "$ref": "https://schemas.revagent.local/addin-loopback/v1/json-rpc-response.schema.json#/$defs/successResponse"
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/result"
            }
          }
        }
      ]
    }
  }
}
