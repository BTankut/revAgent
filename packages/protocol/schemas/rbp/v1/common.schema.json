{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.revagent.app/rbp/v1/common.schema.json",
  "title": "RBP/1 common schema definitions",
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rsid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "boundedString": {
      "type": "string",
      "maxLength": 4096
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "guardedReason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verificationHoldId": {
      "type": "string",
      "pattern": "^vh:[0-9a-f]{64}$"
    },
    "mutationScope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "session"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "kind",
            "document_id"
          ],
          "properties": {
            "kind": {
              "const": "document"
            },
            "document_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "ackEntry": {
      "type": "object",
      "required": [
        "rsid",
        "seq"
      ],
      "properties": {
        "rsid": {
          "$ref": "#/$defs/rsid"
        },
        "seq": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "title",
        "path_digest",
        "is_workshared",
        "is_active"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/boundedString"
        },
        "path_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_workshared": {
          "type": "boolean"
        },
        "is_active": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "contains": {
        "type": "object",
        "required": [
          "is_active"
        ],
        "properties": {
          "is_active": {
            "const": true
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "class",
            "decision",
            "confirmation_id"
          ],
          "properties": {
            "class": {
              "const": "auto"
            },
            "decision": {
              "const": "auto"
            },
            "confirmation_id": {
              "type": "null"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "class",
            "decision",
            "confirmation_id"
          ],
          "properties": {
            "class": {
              "const": "confirm"
            },
            "decision": {
              "const": "confirmed"
            },
            "confirmation_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "class",
            "decision",
            "confirmation_id"
          ],
          "properties": {
            "class": {
              "const": "gated"
            },
            "decision": {
              "const": "gated_approved"
            },
            "confirmation_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "display": {
      "type": "object",
      "properties": {
        "task_name": {
          "$ref": "#/$defs/boundedString"
        },
        "wrapper_action": {
          "$ref": "#/$defs/boundedString"
        },
        "logical_tool_name": {
          "$ref": "#/$defs/boundedString"
        },
        "parent_task_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedString"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_task_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedString"
            },
            {
              "type": "null"
            }
          ]
        },
        "suppress_task_status_window": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": [
        "execute_ms",
        "request_bytes",
        "response_bytes",
        "framing"
      ],
      "properties": {
        "execute_ms": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "request_bytes": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "response_bytes": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "framing": {
          "const": "length-prefixed"
        }
      },
      "additionalProperties": true
    },
    "faultClass": {
      "type": "string",
      "enum": [
        "protocol",
        "auth",
        "policy",
        "unsupported",
        "parameter",
        "environment",
        "revit_busy",
        "revit_timeout",
        "revit_api",
        "addin_unreachable",
        "journal_indeterminate",
        "oversize",
        "cancelled"
      ]
    },
    "errorDetail": {
      "type": "object",
      "required": [
        "retryable",
        "fault_class",
        "outcome",
        "verification_required",
        "message"
      ],
      "properties": {
        "retryable": {
          "type": "boolean"
        },
        "fault_class": {
          "$ref": "#/$defs/faultClass"
        },
        "message": {
          "$ref": "#/$defs/boundedString"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "known",
            "indeterminate"
          ]
        },
        "verification_required": {
          "type": "boolean"
        },
        "replayed": {
          "type": "boolean"
        },
        "late_after_indeterminate": {
          "type": "boolean"
        },
        "verification_hold_id": {
          "$ref": "#/$defs/verificationHoldId"
        },
        "mutation_scope": {
          "$ref": "#/$defs/mutationScope"
        },
        "result_digest": {
          "$ref": "#/$defs/sha256"
        },
        "addin_error": {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "$ref": "#/$defs/boundedString"
            }
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "fault_class"
            ],
            "properties": {
              "fault_class": {
                "const": "journal_indeterminate"
              }
            }
          },
          "then": {
            "required": [
              "outcome",
              "verification_required",
              "verification_hold_id",
              "mutation_scope"
            ],
            "properties": {
              "retryable": {
                "const": false
              },
              "outcome": {
                "const": "indeterminate"
              },
              "verification_required": {
                "const": true
              },
              "late_after_indeterminate": {
                "const": false
              }
            },
            "not": {
              "required": [
                "result_digest"
              ]
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "const": "known"
              },
              "verification_required": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "late_after_indeterminate"
            ],
            "properties": {
              "late_after_indeterminate": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "replayed",
              "verification_hold_id",
              "result_digest"
            ],
            "properties": {
              "replayed": {
                "const": true
              }
            },
            "not": {
              "required": [
                "fault_class"
              ],
              "properties": {
                "fault_class": {
                  "const": "journal_indeterminate"
                }
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "fault_class"
              ],
              "properties": {
                "fault_class": {
                  "not": {
                    "const": "journal_indeterminate"
                  }
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "verification_hold_id"
                    ]
                  },
                  {
                    "required": [
                      "mutation_scope"
                    ]
                  },
                  {
                    "required": [
                      "result_digest"
                    ]
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "inlineOrOmittedResult": {
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "properties": {
            "result": {},
            "payload_omitted": {
              "const": false
            },
            "result_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "required": [
            "payload_omitted",
            "result_digest"
          ],
          "properties": {
            "payload_omitted": {
              "const": true
            },
            "result_digest": {
              "$ref": "#/$defs/sha256"
            }
          },
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    }
  }
}
