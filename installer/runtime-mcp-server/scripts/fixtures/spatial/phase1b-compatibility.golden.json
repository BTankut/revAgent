        "action": "query_spatial_context",
        "snapshotId": "snapshot:compat-v02-aabb",
        "revisionFingerprint": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "liveness": "stale",
        "mode": "operation",
        "operation": "above_below",
        "computed": {
          "relation": "first_above_second",
          "separationMm": 900
        },
        "basis": "aabb",
        "precisionClass": "candidate",
        "verdictCapability": "context_only",
        "adapterId": "spatial-snapshot-v0.2-query/1",
        "partial": false,
        "truncated": false,
        "nextCursor": null,
        "warnings": [
          "The v0.2 result is historical because liveness=stale."
        ],
        "notices": []
      }
    },
