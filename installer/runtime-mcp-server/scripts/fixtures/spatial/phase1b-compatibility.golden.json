          "nodes": [
            {
              "nodeId": "node:compat-v02-high",
              "geometry": {
                "aabb": {
                  "min": [
                    0,
                    0,
                    2000
                  ],
                  "max": [
                    1000,
                    1000,
                    2200
                  ]
                },
                "geometryFingerprint": "sha256:2323232323232323232323232323232323232323232323232323232323232323"
