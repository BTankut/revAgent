{
  "fixtureVersion": "1.0",
  "suite": "spatial_phase1b_compatibility_gold",
  "description": "Synthetic compatibility and fail-closed gold cases for stored SpatialSnapshot v0.1/v0.2/v0.3 records.",
  "normalization": {
    "sortRules": [
      "capabilities and missingCapabilities by ordinal code",
      "warnings and notices by ordinal text"
    ],
    "excludedNondeterministicFields": [
      "evaluatedAt",
      "elapsedMs"
    ]
  },
  "adapters": [
    {
      "adapterId": "spatial-snapshot-v0.1-readonly-identity/1",
      "fromSchemaVersion": "0.1",
      "toSchemaVersion": "0.3",
      "supportedCapabilities": [
        "identity",
        "placement_identity"
      ],
      "missingCapabilities": [
        "current_liveness",
        "analytic_profile_distance",
        "native_connector_adjacency",
        "property_fingerprint",
        "topology_fingerprint"
      ]
    },
    {
      "adapterId": "spatial-snapshot-v0.2-query/1",
      "fromSchemaVersion": "0.2",
      "toSchemaVersion": "0.3",
      "supportedCapabilities": [
        "identity",
        "aabb",
        "boundary_loops",
        "centerline",
        "legacy_geometry_fingerprint",
        "tracked_liveness"
      ],
      "missingCapabilities": [
        "analytic_profile_distance",
        "native_connector_adjacency",
        "property_fingerprint",
        "separate_placement_and_shape_fingerprints",
        "topology_fingerprint"
      ]
    }
  ],
  "cases": [
    {
      "caseId": "v0_1_identity_only_is_not_current_query_evidence",
      "input": {
        "snapshot": {
          "snapshotId": "snapshot:compat-v01",
          "schemaVersion": "0.1",
          "atomic": false,
          "liveness": "unknown",
          "partial": false,
          "scopeFingerprint": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "revisionFingerprint": "sha256:1212121212121212121212121212121212121212121212121212121212121212"
        },
        "requestedOperation": "above_below"
      },
      "expectedNormalizedOutput": {
        "success": true,
        "guarded": true,
        "state": "guarded",
        "action": "query_spatial_context",
        "reason": "snapshot_capability_mismatch",
        "snapshotId": "snapshot:compat-v01",
        "liveness": "unknown",
        "operation": "above_below",
        "availableCapabilities": [
          "identity",
          "placement_identity"
        ],
        "missingCapabilities": [
          "atomic_snapshot",
          "measured_geometry"
        ],
        "verdictCapability": "context_only",
        "warnings": [
          "SpatialSnapshot v0.1 is historical Phase 0 evidence and cannot support a current deterministic relation."
        ],
        "notices": []
      }
    },
    {
