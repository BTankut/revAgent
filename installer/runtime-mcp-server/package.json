{
  "name": "revit-mcp",
  "version": "1.0.0",
  "description": "Bundled local MCP server for the self-contained Revit MCP skill package.",
  "private": true,
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "revit-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc",
    "guard-test": "node build/tools/send_code_to_revit_safe.guard-test.js",
    "fire-audit-test": "node build/fire-piping/fireTopologyAudit.test.js",
    "dcw-dhw-test": "node scripts/dcw-dhw-sizing.test.mjs",
    "hydronic-test": "node build/engineering/hydronic/hydronicAnalysis.test.js",
    "ducting-test": "node scripts/ducting-engineering.test.mjs",
    "socket-test": "node scripts/socket-client.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sanitary-rainwater-test": "node scripts/sanitary-rainwater.test.mjs",
    "test": "npm run build && npm run guard-test && npm run ducting-test && npm run hydronic-test && npm run dcw-dhw-test && npm run sanitary-rainwater-test && npm run fire-audit-test && npm run socket-test && npm run smoke"
  },
  "files": [
    "build",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTankut/revit-mcp-skill.git"
  },
  "keywords": [
    "revit",
    "mcp",
    "codex"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/BTankut/revit-mcp-skill/issues"
  },
  "homepage": "https://github.com/BTankut/revit-mcp-skill#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.9.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.2"
  }
}
