{
  "name": "revit-mcp",
  "version": "1.0.0",
  "description": "Bundled local MCP server for the self-contained Revit MCP skill package.",
  "private": true,
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "revit-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc",
    "guard-test": "node build/tools/send_code_to_revit_safe.guard-test.js",
    "runtime-result-test": "node scripts/runtime-result.test.mjs",
    "broad-scan-result-test": "node scripts/broad-scan-result.test.mjs",
    "excel-ingestion-test": "node scripts/excel-ingestion.test.mjs",
    "write-tool-contract-test": "node scripts/write-tool-contract.test.mjs",
    "bridge-result-contract-test": "node scripts/bridge-result-contract.test.mjs",
    "casing-member-access-test": "node scripts/casing-member-access.test.mjs",
    "tool-inference-test": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck scripts/tool-inference-contract.test.ts",
    "revit-task-merge-test": "node scripts/revit-task-merge.test.mjs",
    "live-feed-test": "node scripts/live-feed.test.mjs",
    "socket-test": "node scripts/socket-client.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && npm run guard-test && npm run runtime-result-test && npm run broad-scan-result-test && npm run excel-ingestion-test && npm run write-tool-contract-test && npm run bridge-result-contract-test && npm run casing-member-access-test && npm run tool-inference-test && npm run revit-task-merge-test && npm run live-feed-test && npm run socket-test && npm run smoke"
  },
  "files": [
    "build",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTankut/revit-mcp-skill.git"
  },
  "keywords": [
    "revit",
    "mcp",
    "codex"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/BTankut/revit-mcp-skill/issues"
  },
  "homepage": "https://github.com/BTankut/revit-mcp-skill#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.9.0",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "ws": "^8.20.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "brace-expansion": "2.0.3",
    "fast-uri": "3.1.2",
    "hono": "4.12.21",
    "qs": "6.15.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.2"
  }
}
