{
  "name": "revagent-runtime",
  "version": "1.0.0",
  "description": "Bundled local MCP server for the self-contained revAgent standard user package.",
  "private": true,
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "revagent-runtime": "./build/index.js",
    "revit-mcp": "./build/index.js"
  },
  "scripts": {
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "build": "tsc",
    "release:clean": "rimraf release",
    "build:release": "npm run build && npm run release:clean && node ../../scripts/build-mcp-release-bundle.mjs",
    "spatial-store": "node build/index.js spatial-store",
    "guard-test": "node build/tools/send_code_to_revit_safe.guard-test.js",
    "runtime-result-test": "node scripts/runtime-result.test.mjs",
    "broad-scan-result-test": "node scripts/broad-scan-result.test.mjs",
    "excel-ingestion-test": "node scripts/excel-ingestion.test.mjs",
    "schedule-adapter-test": "node scripts/schedule-adapter.test.mjs",
    "matching-scoring-test": "node scripts/matching-scoring.test.mjs",
    "reconcile-tool-test": "node scripts/reconcile-tool.test.mjs",
    "find-elements-compact-test": "node scripts/find-elements-compact.test.mjs",
    "write-tool-contract-test": "node scripts/write-tool-contract.test.mjs",
    "bridge-result-contract-test": "node scripts/bridge-result-contract.test.mjs",
    "spatial-phase0-contract-test": "node scripts/spatial-phase0-contract.test.mjs",
    "spatial-phase1a-store-test": "node scripts/spatial-phase1a-store.test.mjs",
    "spatial-store-cli-test": "node scripts/spatial-store-cli.test.mjs",
    "spatial-phase1a-capture-test": "node scripts/spatial-phase1a-capture.test.mjs",
    "spatial-phase1a-contract-test": "node scripts/spatial-phase1a-contract.test.mjs",
    "spatial-phase1b-contract-test": "node scripts/spatial-phase1b-contract.test.mjs",
    "spatial-phase1b-fingerprint-test": "node scripts/spatial-phase1b-fingerprint.test.mjs",
    "spatial-phase1b-store-test": "node scripts/spatial-phase1b-store.test.mjs",
    "spatial-phase1b-query-test": "node scripts/spatial-phase1b-query.test.mjs",
    "spatial-phase1b-diff-test": "node scripts/spatial-phase1b-diff.test.mjs",
    "spatial-phase1b-summary-test": "node scripts/spatial-phase1b-summary.test.mjs",
    "spatial-phase1b-golden-test": "node scripts/spatial-phase1b-golden.test.mjs",
    "spatial-phase1b-eval-contract-test": "node scripts/spatial-phase1b-eval-contract.test.mjs",
    "spatial-phase1b-agent-evidence-test": "node scripts/spatial-phase1b-agent-evidence.test.mjs",
    "spatial-phase1b-performance-test": "node scripts/spatial-phase1b-performance.test.mjs",
    "casing-member-access-test": "node scripts/casing-member-access.test.mjs",
    "tool-inference-test": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck scripts/tool-inference-contract.test.ts",
    "revit-task-merge-test": "node scripts/revit-task-merge.test.mjs",
    "live-feed-test": "node scripts/live-feed.test.mjs",
    "socket-test": "node scripts/socket-client.test.mjs",
    "env-alias-test": "node scripts/env-alias.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && npm run guard-test && npm run runtime-result-test && npm run broad-scan-result-test && npm run excel-ingestion-test && npm run schedule-adapter-test && npm run matching-scoring-test && npm run reconcile-tool-test && npm run find-elements-compact-test && npm run write-tool-contract-test && npm run bridge-result-contract-test && npm run spatial-phase0-contract-test && npm run spatial-phase1a-contract-test && npm run spatial-phase1a-store-test && npm run spatial-store-cli-test && npm run spatial-phase1a-capture-test && npm run spatial-phase1b-contract-test && npm run spatial-phase1b-fingerprint-test && npm run spatial-phase1b-store-test && npm run spatial-phase1b-query-test && npm run spatial-phase1b-diff-test && npm run spatial-phase1b-summary-test && npm run spatial-phase1b-golden-test && npm run spatial-phase1b-eval-contract-test && npm run spatial-phase1b-agent-evidence-test && npm run spatial-phase1b-performance-test && npm run casing-member-access-test && npm run tool-inference-test && npm run revit-task-merge-test && npm run live-feed-test && npm run socket-test && npm run env-alias-test && npm run smoke"
  },
  "files": [
    "build",
    "schemas",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTankut/revAgent.git"
  },
  "keywords": [
    "revit",
    "mcp",
    "codex"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/BTankut/revAgent/issues"
  },
  "homepage": "https://github.com/BTankut/revAgent#readme",
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "12.9.0",
    "csv-parse": "^6.2.1",
    "ws": "^8.20.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "brace-expansion": "2.0.3",
    "fast-uri": "3.1.2",
    "hono": "4.12.27",
    "qs": "6.15.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.27.2",
    "fflate": "^0.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.2"
  }
}
