{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.revagent.app/spatial/v0.2/work-cursor-envelope.schema.json",
  "title": "revAgent Spatial WorkCursorEnvelope v0.2",
  "description": "Decoded authenticated cursor for bounded native Phase 1a preparation work. It is distinct from a data-page cursor and is never caller-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cursorVersion",
    "cursorKind",
    "captureId",
    "workPhase",
    "stepOrdinal",
    "scopeFingerprint",
    "sourceBindingFingerprint",
    "capturedAt"
  ],
  "properties": {
    "cursorVersion": { "const": "0.2-work" },
    "cursorKind": { "const": "work" },
    "captureId": { "type": "string", "minLength": 1 },
    "workPhase": {
      "type": "string",
      "enum": ["discover", "filter", "extract", "finalize"]
    },
    "stepOrdinal": { "type": "integer", "minimum": 1 },
    "scopeFingerprint": { "$ref": "#/$defs/sha256" },
    "sourceBindingFingerprint": { "$ref": "#/$defs/sha256" },
    "capturedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
