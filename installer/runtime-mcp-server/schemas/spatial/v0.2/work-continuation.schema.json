{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.revagent.app/spatial/v0.2/work-continuation.schema.json",
  "title": "revAgent Spatial Work Continuation v0.2",
  "description": "Strict native progress response for bounded Phase 1a discover/filter/extract/finalize work. It is not a spatial data page and must never be staged in the durable store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultContractVersion", "success", "guarded", "state", "action",
    "reason", "message", "error", "schemaVersion", "extractorVersion",
    "coordinateFrame", "lengthUnit", "captureId", "snapshotId", "capturedAt",
    "atomic", "liveness", "captureConsistency", "continuationKind",
    "sourceBindingFingerprint", "preparation", "revisionBasisCaveat", "scope",
    "effectiveSourcePolicy", "sourceRevisions", "scopeFingerprint",
    "revisionFingerprint", "nodes", "omissions", "counts", "coverage",
    "transformValidation", "page", "pageCount", "payloadBytes", "nextCursor",
    "partial", "coverageStatus", "scanStoppedReason", "scanPolicy",
    "suggestedNextScopes", "elapsedMs", "lastReadDocumentKey",
    "lastReadLinkInstanceUniqueId", "lastReadNodeKind", "lastReadItemId",
    "warnings", "notices"
  ],
  "properties": {
    "resultContractVersion": { "type": "integer", "minimum": 2 },
    "success": { "const": true },
    "guarded": { "const": false },
    "state": { "const": "in_progress" },
    "action": { "const": "extract_spatial_snapshot" },
    "reason": { "type": "null" },
    "message": { "type": "string", "minLength": 1 },
    "error": { "type": "null" },
    "schemaVersion": { "const": "0.2" },
    "extractorVersion": { "type": "string", "minLength": 1 },
    "coordinateFrame": { "const": "host_internal_mm" },
    "lengthUnit": { "const": "mm" },
    "captureId": { "type": "string", "minLength": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "atomic": { "const": false },
    "liveness": { "const": "staging" },
    "captureConsistency": { "const": "document_change_sequence_bound" },
    "continuationKind": { "const": "work" },
    "sourceBindingFingerprint": { "$ref": "#/$defs/sha256" },
    "preparation": { "$ref": "#/$defs/preparation" },
    "revisionBasisCaveat": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "./extraction-page.schema.json#/properties/scope" },
    "effectiveSourcePolicy": { "$ref": "./extraction-page.schema.json#/properties/effectiveSourcePolicy" },
    "sourceRevisions": { "type": "null" },
    "scopeFingerprint": { "$ref": "#/$defs/sha256" },
    "revisionFingerprint": { "type": "null" },
    "nodes": { "type": "null" },
    "omissions": { "type": "null" },
    "counts": { "type": "null" },
    "coverage": { "type": "null" },
    "transformValidation": { "type": "null" },
    "page": { "type": "null" },
    "pageCount": { "const": 0 },
    "payloadBytes": { "const": 0 },
    "nextCursor": { "type": "string", "minLength": 1, "pattern": "^spatial-work-cursor-v0\\.2\\." },
    "partial": { "const": false },
    "coverageStatus": { "type": "null" },
    "scanStoppedReason": { "type": "null" },
    "scanPolicy": { "$ref": "./extraction-page.schema.json#/properties/scanPolicy" },
    "suggestedNextScopes": { "type": "array", "maxItems": 0 },
    "elapsedMs": { "type": "integer", "minimum": 0 },
    "lastReadDocumentKey": { "type": "null" },
    "lastReadLinkInstanceUniqueId": { "type": "null" },
    "lastReadNodeKind": { "type": "null" },
    "lastReadItemId": { "type": "null" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "notices": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "stepOrdinal", "processed", "total", "hasMore", "cursorVersion", "nextCursor", "uiOccupancyTargetMs"],
      "properties": {
        "phase": { "type": "string", "enum": ["discover", "filter", "extract", "finalize"] },
        "stepOrdinal": { "type": "integer", "minimum": 1 },
        "processed": { "type": "integer", "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "hasMore": { "const": true },
        "cursorVersion": { "const": "0.2-work" },
        "nextCursor": { "type": "string", "minLength": 1, "pattern": "^spatial-work-cursor-v0\\.2\\." },
        "uiOccupancyTargetMs": { "type": "integer", "minimum": 250, "maximum": 5000 }
      }
    }
  }
}
