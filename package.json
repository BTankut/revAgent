{
  "name": "revagent-migration-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check:generated": "npm run check:generated --workspace @revagent/protocol",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run check:generated && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.39.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "brace-expansion": "2.0.3",
    "fast-uri": "3.1.2",
    "hono": "4.12.27",
    "qs": "6.15.2",
    "uuid": "11.1.1"
  }
}
