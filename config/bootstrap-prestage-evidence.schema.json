{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpe.local/revagent/bootstrap-prestage-evidence.schema.json",
  "title": "revAgent bootstrap prestage evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "evidenceType",
    "producerMode",
    "supervisedAdminPrestage",
    "generatedAtUtc",
    "generatedBySid",
    "release",
    "localBootstrapInstallerScript",
    "localBootstrapInstallerModule",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "const": "revAgent" },
    "evidenceType": { "const": "bootstrap-prestage" },
    "producerMode": { "enum": ["unelevated-coordinator", "supervised-admin-prestage"] },
    "supervisedAdminPrestage": { "type": "boolean" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "generatedBySid": { "type": "string", "pattern": "^S-[0-9]+(?:-[0-9]+)+$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "channel", "version", "releaseSequence", "minimumAcceptedReleaseSequence", "highestAcceptedReleaseSequence", "channelManifestSha256", "releaseManifestSha256", "packageSha256", "signatureVerified", "pilotPolicy"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["stable", "pilot"] },
        "version": { "type": "string", "minLength": 1 },
        "releaseSequence": { "type": "integer", "minimum": 1 },
        "minimumAcceptedReleaseSequence": { "type": "integer", "minimum": 0 },
        "highestAcceptedReleaseSequence": { "type": "integer", "minimum": 1 },
        "channelManifestSha256": { "$ref": "#/$defs/sha256" },
        "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "signatureVerified": { "const": true },
        "pilotPolicy": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "allowedMachineNames"],
              "properties": {
                "schemaVersion": { "const": 1 },
                "allowedMachineNames": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,62}$" }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "channel": { "const": "stable" } } },
          "then": { "properties": { "pilotPolicy": { "type": "null" } } }
        },
        {
          "if": { "properties": { "channel": { "const": "pilot" } } },
          "then": { "properties": { "pilotPolicy": { "type": "object" } } }
        }
      ]
    },
    "localBootstrapInstallerScript": { "$ref": "#/$defs/sha256" },
    "localBootstrapInstallerModule": { "$ref": "#/$defs/sha256" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "launcher", "updaterGui", "distributionIntegrity", "permissions", "sourceFreeMigration", "releaseSnapshot", "privilegedSnapshotUpdate", "trustedKeys"],
      "properties": {
        "bootstrap": { "$ref": "#/$defs/sha256" },
        "launcher": { "$ref": "#/$defs/sha256" },
        "updaterGui": { "$ref": "#/$defs/sha256" },
        "distributionIntegrity": { "$ref": "#/$defs/sha256" },
        "permissions": { "$ref": "#/$defs/sha256" },
        "sourceFreeMigration": { "$ref": "#/$defs/sha256" },
        "releaseSnapshot": { "$ref": "#/$defs/sha256" },
        "privilegedSnapshotUpdate": { "$ref": "#/$defs/sha256" },
        "trustedKeys": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "supervisedAdminPrestage": { "const": true } } },
      "then": { "properties": { "producerMode": { "const": "supervised-admin-prestage" } } },
      "else": { "properties": { "producerMode": { "const": "unelevated-coordinator" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  },
  "$comment": "producerMode and supervisedAdminPrestage are intentionally redundant audit evidence and must agree."
}
