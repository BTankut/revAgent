{
  "schemaVersion": 1,
  "defaultVersion": "2022",
  "versions": {
    "2022": {
      "label": "Autodesk Revit 2022",
      "targetFramework": "net48",
      "buildConfiguration": "Release R22",
      "addinPathPattern": "%ProgramData%\\Autodesk\\Revit\\Addins\\{version}",
      "installRootCandidatePatterns": [
        "%REVIT_INSTALL_ROOT%",
        "%ProgramFiles%\\Autodesk\\Revit {version}",
        "%ProgramFiles%\\Autodesk\\Revit{version}",
        "%ProgramFiles(x86)%\\Autodesk\\Revit {version}"
      ],
      "registryRoots": [
        "HKLM:\\SOFTWARE\\Autodesk\\Revit\\{version}",
        "HKLM:\\SOFTWARE\\Autodesk\\Revit\\Autodesk Revit {version}",
        "HKLM:\\SOFTWARE\\WOW6432Node\\Autodesk\\Revit\\{version}",
        "HKLM:\\SOFTWARE\\WOW6432Node\\Autodesk\\Revit\\Autodesk Revit {version}"
      ],
      "apiPackages": {
        "RevitAPI": "Nice3point.Revit.Api.RevitAPI:2022.*",
        "RevitAPIUI": "Nice3point.Revit.Api.RevitAPIUI:2022.*",
        "RevitMCPSDK": "RevitMCPSDK:2022.*"
      },
      "payload": {
        "installerPluginPath": "installer\\revit-plugin\\revit_mcp_plugin",
        "commandPayloadPath": "installer\\command-payload",
        "commandRuntimePath": "installer\\command-payload\\runtime\\2022",
