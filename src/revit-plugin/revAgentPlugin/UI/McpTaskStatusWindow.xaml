<Window x:Class="RevAgentPlugin.UI.McpTaskStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="revAgent Status"
        Width="500"
        Height="420"
        MinWidth="440"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        ShowActivated="False"
        ShowInTaskbar="True"
        Topmost="False"
        Background="#FFFFFFFF">
    <Border x:Name="RootBorder"
            BorderBrush="#D18A00"
            BorderThickness="2"
            Background="#FFFFF3D6"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           FontFamily="Segoe UI"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="revAgent is working"/>
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            Width="170"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            TextBlock.TextAlignment="Right">
                    <TextBlock x:Name="VersionText"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#FF555555"
                               TextTrimming="CharacterEllipsis"
                               Text="Version"/>
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,1,0,0"
                               FontFamily="Segoe UI"
                               FontSize="9.5"
                               Foreground="#FF777777"
                               TextTrimming="CharacterEllipsis"
                               Text="Up to date"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,2,0,8"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#FF555555"
                       Text="Your AI agent inside Revit."/>

            <TextBlock x:Name="TaskText"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       MaxHeight="42"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Text="Task: revAgent task"/>

            <TextBlock x:Name="ElapsedText"
                       Grid.Row="3"
                       Margin="0,4,0,0"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Text="Elapsed: 0.00s"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="4"
                       Margin="0,12,0,0"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="Please do not use Revit until this finishes."/>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="5"
                       Margin="0,8,0,0"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       MaxHeight="48"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>

            <Border Grid.Row="6"
                    Margin="0,12,0,0"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    Background="#66FFFFFF"
                    Padding="8"
                    VerticalAlignment="Stretch"
                    MinHeight="0">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Recent tasks"/>
                    <TextBox x:Name="HistoryText"
                             Grid.Row="1"
                             Margin="0,6,0,0"
                             MinHeight="0"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Text="No completed tasks yet."/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="7"
                       Margin="0,14,104,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#FF666666"
                       Text="revAgent  |  &#x00A9; 2026 Baris Tankut  |  www.revagent.app"/>

            <Button x:Name="AckButton"
                    Grid.Row="7"
                    Width="88"
                    Height="30"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Content="OK"
                    Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
