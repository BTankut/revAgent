<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RevitMCPViewCommandSet</AssemblyName>
    <RootNamespace>RevitMCPViewCommandSet</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Configurations>Debug 2022;Debug 2023;Debug 2024;Debug 2025;Release 2022;Release 2023;Release 2024;Release 2025</Configurations>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('2022'))">
    <RevitVersion>2022</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2023'))">
    <RevitVersion>2023</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2024'))">
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('2025'))">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>bin\$(Configuration.Split(' ')[0])\$(RevitVersion)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" />
    <PackageReference Include="RevitMCPSDK" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="command.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
