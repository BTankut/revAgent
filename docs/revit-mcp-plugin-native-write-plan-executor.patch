+using Newtonsoft.Json.Linq;
+
+namespace SampleCommandSet.Commands.WritePlan.Models
+{
+    public static class WritePlanResult
+    {
+        public static JObject Create(string mode, JObject plan, bool success)
+        {
+            string planId = plan != null && plan["planId"] != null ? plan["planId"].ToString() : "";
+            string riskLevel = plan != null && plan["riskLevel"] != null ? plan["riskLevel"].ToString() : "low";
+            return new JObject
+            {
+                ["success"] = success,
+                ["mode"] = mode,
+                ["planId"] = planId,
+                ["riskLevel"] = riskLevel,
+                ["warnings"] = new JArray(),
+                ["errors"] = new JArray(),
+                ["previewRows"] = new JArray(),
+                ["mappings"] = new JArray(),
+                ["audit"] = new JObject
+                {
+                    ["mode"] = mode,
+                    ["planId"] = planId
+                }
+            };
+        }
+
+        public static void AddError(JObject result, string message)
+        {
+            JArray errors = result["errors"] as JArray;
+            if (errors == null)
+            {
+                errors = new JArray();
+                result["errors"] = errors;
+            }
+            errors.Add(message);
+            result["success"] = false;
+        }
+
+        public static void AddWarning(JObject result, string message)
+        {
+            JArray warnings = result["warnings"] as JArray;
+            if (warnings == null)
+            {
+                warnings = new JArray();
+                result["warnings"] = warnings;
+            }
+            warnings.Add(message);
+        }
+    }
+}
diff --git a/SampleCommandSet/Commands/WritePlan/Operations/WritePlanExecutor.cs b/SampleCommandSet/Commands/WritePlan/Operations/WritePlanExecutor.cs
new file mode 100644
index 0000000..718f0a4
--- /dev/null
+++ b/SampleCommandSet/Commands/WritePlan/Operations/WritePlanExecutor.cs
@@ -0,0 +1,595 @@
+using Autodesk.Revit.DB;
+using Autodesk.Revit.DB.Structure;
+using Newtonsoft.Json.Linq;
+using SampleCommandSet.Commands.WritePlan.Models;
+using SampleCommandSet.Commands.WritePlan.Preview;
+using SampleCommandSet.Commands.WritePlan.Validators;
+using SampleCommandSet.Commands.WritePlan.Verification;
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+
+namespace SampleCommandSet.Commands.WritePlan.Operations
+{
+    public static class WritePlanExecutor
+    {
+        public static JObject Execute(Document document, string mode, JObject plan, string commitToken)
+        {
+            string normalizedMode = string.IsNullOrWhiteSpace(mode) ? "validate" : mode.Trim().ToLowerInvariant();
+            JObject result = WritePlanResult.Create(normalizedMode, plan, true);
+            JObject validation = WritePlanValidator.Validate(normalizedMode, plan, commitToken);
+            result["validation"] = validation;
+
+            if (!(bool)validation["valid"])
+            {
+                CopyMessages(validation["errors"] as JArray, result["errors"] as JArray);
+                CopyMessages(validation["warnings"] as JArray, result["warnings"] as JArray);
+                result["success"] = false;
+                return result;
+            }
+
+            if (normalizedMode == "validate")
+                return result;
+
+            if (normalizedMode == "preview")
+            {
+                result["previewRows"] = WritePlanPreviewBuilder.Build(document, plan);
+                return result;
+            }
+
+            if (normalizedMode == "verify")
+            {
+                JObject verification = WritePlanVerifier.Verify(document, plan);
+                result["verification"] = verification;
+                result["previewRows"] = verification["rows"] as JArray ?? new JArray();
+                CopyMessages(verification["warnings"] as JArray, result["warnings"] as JArray);
+                CopyMessages(verification["errors"] as JArray, result["errors"] as JArray);
+                result["success"] = verification["success"] != null && (bool)verification["success"];
+                return result;
+            }
+
+            if (normalizedMode == "commit")
+            {
+                if (string.IsNullOrWhiteSpace(commitToken))
+                {
+                    WritePlanResult.AddError(result, "Commit rejected: commitToken is required.");
+                    return result;
+                }
+                JArray mappings = new JArray();
+                Dictionary<string, ElementId> eIdMap = new Dictionary<string, ElementId>();
+                using (Transaction tx = new Transaction(document, "MCP Execute Write Plan"))
+                {
+                    try
+                    {
+                        tx.Start();
+                        JArray steps = plan["steps"] as JArray;
+                        for (int i = 0; i < steps.Count; i++)
+                        {
+                            JObject step = steps[i] as JObject;
+                            if (step == null) continue;
+                            ExecuteStep(document, step, eIdMap, mappings, result);
+                            if (!(bool)result["success"])
+                            {
+                                tx.RollBack();
+                                return result;
+                            }
+                        }
+                        tx.Commit();
+                    }
+                    catch (Exception ex)
+                    {
+                        if (tx.GetStatus() == TransactionStatus.Started)
+                            tx.RollBack();
+                        WritePlanResult.AddError(result, ex.Message);
+                        return result;
+                    }
+                }
+                result["mappings"] = mappings;
+                result["previewRows"] = WritePlanPreviewBuilder.Build(document, plan);
+                return result;
+            }
+
+            WritePlanResult.AddError(result, "Unsupported mode: " + normalizedMode);
+            return result;
+        }
+
+        public static JObject BuildPreviewRow(Document document, JObject plan, JObject step)
+        {
+            string operation = StringValue(step, "operation");
+            JObject row = new JObject
+            {
+                ["planId"] = StringValue(plan, "planId"),
+                ["stepId"] = StringValue(step, "stepId"),
+                ["eId"] = StringValue(step, "eId"),
+                ["operation"] = operation,
+                ["riskLevel"] = StringValue(step, "riskLevel"),
+                ["willMutateModel"] = false,
+                ["status"] = "preview"
+            };
+
+            Element elem = TryGetSingleTargetElement(document, step, null);
+            if (elem != null)
+            {
+                row["elementId"] = elem.Id.IntegerValue;
+                row["uniqueId"] = elem.UniqueId;
+                row["category"] = elem.Category != null ? elem.Category.Name : "";
+            }
+
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            if (operation == "set_parameter" || operation == "clear_parameter")
+            {
+                Parameter p = elem != null ? elem.LookupParameter(StringValue(args, "parameterName")) : null;
+                row["parameterName"] = StringValue(args, "parameterName");
+                row["oldValue"] = ParameterText(p);
+                row["newValue"] = operation == "clear_parameter" ? "" : JTokenText(args["value"]);
+            }
+            else if (operation == "copy_parameter_value")
+            {
+                row["sourceParameterName"] = StringValue(args, "sourceParameterName");
+                row["targetParameterName"] = StringValue(args, "targetParameterName");
+            }
+            else
+            {
+                row["arguments"] = args.DeepClone();
+            }
+            return row;
+        }
+
+        public static JObject VerifySetParameter(Document document, JObject step)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = TryGetSingleTargetElement(document, step, null);
+            Parameter p = elem != null ? elem.LookupParameter(StringValue(args, "parameterName")) : null;
+            string actual = ParameterRawText(p);
+            string expected = JTokenText(args["value"]);
+            bool ok = p != null && string.Equals(actual, expected, StringComparison.OrdinalIgnoreCase);
+            return new JObject
+            {
+                ["success"] = ok,
+                ["stepId"] = StringValue(step, "stepId"),
+                ["operation"] = "set_parameter",
+                ["parameterName"] = StringValue(args, "parameterName"),
+                ["expected"] = expected,
+                ["actual"] = actual,
+                ["message"] = ok ? "verified" : "parameter value does not match expected value"
+            };
+        }
+
+        public static string StringValue(JObject obj, string name)
+        {
+            return obj != null && obj[name] != null ? obj[name].ToString() : "";
+        }
+
+        private static void ExecuteStep(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            string operation = StringValue(step, "operation");
+            if (operation == "set_parameter")
+                SetParameter(document, step, eIdMap, mappings, result);
+            else if (operation == "clear_parameter")
+                ClearParameter(document, step, eIdMap, mappings, result);
+            else if (operation == "copy_parameter_value")
+                CopyParameterValue(document, step, eIdMap, mappings, result);
+            else if (operation == "change_type")
+                ChangeType(document, step, eIdMap, mappings, result);
+            else if (operation == "view_hide_elements")
+                SetViewHidden(document, step, true, result);
+            else if (operation == "view_unhide_elements")
+                SetViewHidden(document, step, false, result);
+            else if (operation == "view_apply_overrides")
+                ApplyViewOverrides(document, step, result);
+            else if (operation == "place_family_instance")
+                PlaceFamilyInstance(document, step, eIdMap, mappings, result);
+            else if (operation == "move_elements")
+                MoveElements(document, step, result);
+            else if (operation == "create_duct_run")
+                CreateDuctRun(document, step, eIdMap, mappings, result);
+            else if (operation == "resize_duct")
+                ResizeCurve(document, step, eIdMap, result, true);
+            else if (operation == "create_pipe_run")
+                CreatePipeRun(document, step, eIdMap, mappings, result);
+            else if (operation == "resize_pipe")
+                ResizeCurve(document, step, eIdMap, result, false);
+            else
+                WritePlanResult.AddError(result, "Unsupported operation: " + operation);
+        }
+
+        private static void SetParameter(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = GetSingleTargetElement(document, step, eIdMap);
+            Parameter p = RequireWritableParameter(elem, StringValue(args, "parameterName"));
+            SetParameterValue(p, args["value"], StringValue(args, "unit"));
+            AddExistingMapping(step, elem, mappings);
+        }
+
+        private static void ClearParameter(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = GetSingleTargetElement(document, step, eIdMap);
+            Parameter p = RequireWritableParameter(elem, StringValue(args, "parameterName"));
+            ClearParameterValue(p);
+            AddExistingMapping(step, elem, mappings);
+        }
+
+        private static void CopyParameterValue(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element target = GetSingleTargetElement(document, step, eIdMap);
+            Element source = GetElementById(document, IntValue(args["sourceElementId"]));
+            if (source == null && !string.IsNullOrWhiteSpace(StringValue(args, "sourceEId")) && eIdMap.ContainsKey(StringValue(args, "sourceEId")))
+                source = document.GetElement(eIdMap[StringValue(args, "sourceEId")]);
+            if (source == null)
+                throw new InvalidOperationException("Source element not found.");
+            Parameter sourceParam = source.LookupParameter(StringValue(args, "sourceParameterName"));
+            Parameter targetParam = RequireWritableParameter(target, StringValue(args, "targetParameterName"));
+            SetParameterFromParameter(targetParam, sourceParam);
+            AddExistingMapping(step, target, mappings);
+        }
+
+        private static void ChangeType(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = GetSingleTargetElement(document, step, eIdMap);
+            elem.ChangeTypeId(new ElementId(IntValue(args["typeId"])));
+            AddExistingMapping(step, elem, mappings);
+        }
+
+        private static void SetViewHidden(Document document, JObject step, bool hidden, JObject result)
+        {
+            View view = ResolveView(document, step);
+            ICollection<ElementId> ids = GetTargetElementIds(step);
+            if (ids.Count == 0)
+                throw new InvalidOperationException("No target element ids supplied.");
+            if (hidden)
+                view.HideElements(ids);
+            else
+                view.UnhideElements(ids);
+        }
+
+        private static void ApplyViewOverrides(Document document, JObject step, JObject result)
+        {
+            View view = ResolveView(document, step);
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            OverrideGraphicSettings settings = new OverrideGraphicSettings();
+            JObject color = args["projectionLineColor"] as JObject;
+            if (color != null)
+            {
+                settings.SetProjectionLineColor(new Color(
+                    ByteValue(color["red"]),
+                    ByteValue(color["green"]),
+                    ByteValue(color["blue"])));
+            }
+            if (args["projectionLineWeight"] != null)
+                settings.SetProjectionLineWeight(IntValue(args["projectionLineWeight"]));
+            foreach (ElementId id in GetTargetElementIds(step))
+                view.SetElementOverrides(id, settings);
+        }
+
+        private static void PlaceFamilyInstance(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            FamilySymbol symbol = ResolveFamilySymbol(document, args);
+            if (symbol == null)
+                throw new InvalidOperationException("Family symbol not found.");
+            if (!symbol.IsActive)
+                symbol.Activate();
+            XYZ point = PointValue(args["point"] as JObject, StringValue(args, "unit"));
+            FamilyInstance instance = document.Create.NewFamilyInstance(point, symbol, StructuralType.NonStructural);
+            AddCreatedMapping(step, instance, eIdMap, mappings);
+        }
+
+        private static void MoveElements(Document document, JObject step, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            XYZ vector = PointValue(args["vector"] as JObject, StringValue(args, "unit"));
+            ICollection<ElementId> ids = GetTargetElementIds(step);
+            if (ids.Count == 0)
+                throw new InvalidOperationException("No target element ids supplied.");
+            ElementTransformUtils.MoveElements(document, ids, vector);
+        }
+
+        private static void CreateDuctRun(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            ElementId systemTypeId = new ElementId(IntValue(args["systemTypeId"]));
+            ElementId ductTypeId = new ElementId(IntValue(args["ductTypeId"]));
+            ElementId levelId = new ElementId(IntValue(args["levelId"]));
+            JArray points = args["points"] as JArray;
+            if (points == null || points.Count < 2)
+                throw new InvalidOperationException("create_duct_run requires at least two points.");
+            for (int i = 0; i < points.Count - 1; i++)
+            {
+                XYZ a = PointValue(points[i] as JObject, StringValue(args, "unit"));
+                XYZ b = PointValue(points[i + 1] as JObject, StringValue(args, "unit"));
+                Autodesk.Revit.DB.Mechanical.Duct duct = Autodesk.Revit.DB.Mechanical.Duct.Create(document, systemTypeId, ductTypeId, levelId, a, b);
+                AddCreatedMapping(step, duct, eIdMap, mappings, i);
+            }
+        }
+
+        private static void CreatePipeRun(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JArray mappings, JObject result)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            ElementId systemTypeId = new ElementId(IntValue(args["systemTypeId"]));
+            ElementId pipeTypeId = new ElementId(IntValue(args["pipeTypeId"]));
+            ElementId levelId = new ElementId(IntValue(args["levelId"]));
+            JArray points = args["points"] as JArray;
+            if (points == null || points.Count < 2)
+                throw new InvalidOperationException("create_pipe_run requires at least two points.");
+            for (int i = 0; i < points.Count - 1; i++)
+            {
+                XYZ a = PointValue(points[i] as JObject, StringValue(args, "unit"));
+                XYZ b = PointValue(points[i + 1] as JObject, StringValue(args, "unit"));
+                Autodesk.Revit.DB.Plumbing.Pipe pipe = Autodesk.Revit.DB.Plumbing.Pipe.Create(document, systemTypeId, pipeTypeId, levelId, a, b);
+                AddCreatedMapping(step, pipe, eIdMap, mappings, i);
+            }
+        }
+
+        private static void ResizeCurve(Document document, JObject step, Dictionary<string, ElementId> eIdMap, JObject result, bool duct)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            foreach (ElementId id in GetTargetElementIds(step))
+            {
+                Element elem = document.GetElement(id);
+                if (elem == null) continue;
+                if (duct)
+                {
+                    if (args["width"] != null) SetNamedDouble(elem, "Width", args["width"], StringValue(args, "unit"));
+                    if (args["height"] != null) SetNamedDouble(elem, "Height", args["height"], StringValue(args, "unit"));
+                    if (args["diameter"] != null) SetNamedDouble(elem, "Diameter", args["diameter"], StringValue(args, "unit"));
+                }
+                else
+                {
+                    if (args["diameter"] != null) SetNamedDouble(elem, "Diameter", args["diameter"], StringValue(args, "unit"));
+                }
+            }
+        }
+
+        private static Element GetSingleTargetElement(Document document, JObject step, Dictionary<string, ElementId> eIdMap)
+        {
+            Element elem = TryGetSingleTargetElement(document, step, eIdMap);
+            if (elem == null)
+                throw new InvalidOperationException("Target element not found.");
+            return elem;
+        }
+
+        private static Element TryGetSingleTargetElement(Document document, JObject step, Dictionary<string, ElementId> eIdMap)
+        {
+            JObject targets = step["targets"] as JObject ?? new JObject();
+            if (targets["elementId"] != null)
+                return GetElementById(document, IntValue(targets["elementId"]));
+            if (targets["eId"] != null && eIdMap != null && eIdMap.ContainsKey(targets["eId"].ToString()))
+                return document.GetElement(eIdMap[targets["eId"].ToString()]);
+            JArray ids = targets["elementIds"] as JArray;
+            if (ids != null && ids.Count > 0)
+                return GetElementById(document, IntValue(ids[0]));
+            return null;
+        }
+
+        private static ICollection<ElementId> GetTargetElementIds(JObject step)
+        {
+            List<ElementId> ids = new List<ElementId>();
+            JObject targets = step["targets"] as JObject ?? new JObject();
+            if (targets["elementId"] != null)
+                ids.Add(new ElementId(IntValue(targets["elementId"])));
+            JArray array = targets["elementIds"] as JArray;
+            if (array != null)
+            {
+                foreach (JToken token in array)
+                    ids.Add(new ElementId(IntValue(token)));
+            }
+            return ids;
+        }
+
+        private static View ResolveView(Document document, JObject step)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            if (args["viewId"] != null)
+            {
+                View view = document.GetElement(new ElementId(IntValue(args["viewId"]))) as View;
+                if (view != null) return view;
+            }
+            return document.ActiveView;
+        }
+
+        private static Parameter RequireWritableParameter(Element elem, string parameterName)
+        {
+            if (elem == null)
+                throw new InvalidOperationException("Element not found.");
+            Parameter p = elem.LookupParameter(parameterName);
+            if (p == null)
+                throw new InvalidOperationException("Parameter not found: " + parameterName);
+            if (p.IsReadOnly)
+                throw new InvalidOperationException("Parameter is read-only: " + parameterName);
+            return p;
+        }
+
+        private static void SetParameterValue(Parameter p, JToken value, string unit)
+        {
+            if (p.StorageType == StorageType.String)
+                p.Set(JTokenText(value));
+            else if (p.StorageType == StorageType.Integer)
+                p.Set(IntValue(value));
+            else if (p.StorageType == StorageType.Double)
+                p.Set(ConvertToInternal(DoubleValue(value), unit));
+            else if (p.StorageType == StorageType.ElementId)
+                p.Set(new ElementId(IntValue(value)));
+            else
+                throw new InvalidOperationException("Unsupported parameter storage type: " + p.StorageType);
+        }
+
+        private static void SetParameterFromParameter(Parameter target, Parameter source)
+        {
+            if (source == null)
+                throw new InvalidOperationException("Source parameter not found.");
+            if (target.StorageType == StorageType.String)
+                target.Set(source.AsString() ?? source.AsValueString() ?? "");
+            else if (target.StorageType == StorageType.Integer)
+                target.Set(source.StorageType == StorageType.Integer ? source.AsInteger() : 0);
+            else if (target.StorageType == StorageType.Double)
+                target.Set(source.StorageType == StorageType.Double ? source.AsDouble() : 0.0);
+            else if (target.StorageType == StorageType.ElementId)
+                target.Set(source.StorageType == StorageType.ElementId ? source.AsElementId() : ElementId.InvalidElementId);
+        }
+
+        private static void ClearParameterValue(Parameter p)
+        {
+            if (p.StorageType == StorageType.String)
+                p.Set("");
+            else if (p.StorageType == StorageType.Integer)
+                p.Set(0);
+            else if (p.StorageType == StorageType.Double)
+                p.Set(0.0);
+            else if (p.StorageType == StorageType.ElementId)
+                p.Set(ElementId.InvalidElementId);
+        }
+
+        private static void SetNamedDouble(Element elem, string parameterName, JToken value, string unit)
+        {
+            Parameter p = RequireWritableParameter(elem, parameterName);
+            p.Set(ConvertToInternal(DoubleValue(value), unit));
+        }
+
+        private static FamilySymbol ResolveFamilySymbol(Document document, JObject args)
+        {
+            if (args["familySymbolId"] != null)
+                return document.GetElement(new ElementId(IntValue(args["familySymbolId"]))) as FamilySymbol;
+            string familyName = StringValue(args, "familyName");
+            string typeName = StringValue(args, "typeName");
+            FilteredElementCollector collector = new FilteredElementCollector(document)
+                .OfClass(typeof(FamilySymbol));
+            foreach (FamilySymbol symbol in collector.Cast<FamilySymbol>())
+            {
+                string currentFamily = symbol.Family != null ? symbol.Family.Name : "";
+                if (string.Equals(currentFamily, familyName, StringComparison.OrdinalIgnoreCase) &&
+                    string.Equals(symbol.Name, typeName, StringComparison.OrdinalIgnoreCase))
+                    return symbol;
+            }
+            return null;
+        }
+
+        private static Element GetElementById(Document document, int id)
+        {
+            if (id <= 0) return null;
+            return document.GetElement(new ElementId(id));
+        }
+
+        private static void AddExistingMapping(JObject step, Element elem, JArray mappings)
+        {
+            if (elem == null || string.IsNullOrWhiteSpace(StringValue(step, "eId"))) return;
+            mappings.Add(BuildMapping(step, elem, false));
+        }
+
+        private static void AddCreatedMapping(JObject step, Element elem, Dictionary<string, ElementId> eIdMap, JArray mappings, int segmentIndex = -1)
+        {
+            if (elem == null) return;
+            string eId = StringValue(step, "eId");
+            if (string.IsNullOrWhiteSpace(eId))
+                eId = StringValue(step, "stepId");
+            if (segmentIndex >= 0)
+                eId = eId + "-" + (segmentIndex + 1).ToString("000", CultureInfo.InvariantCulture);
+            eIdMap[eId] = elem.Id;
+            JObject mapping = BuildMapping(step, elem, true);
+            mapping["eId"] = eId;
+            mappings.Add(mapping);
+        }
+
+        private static JObject BuildMapping(JObject step, Element elem, bool createdByPlan)
+        {
+            return new JObject
+            {
+                ["eId"] = StringValue(step, "eId"),
+                ["stepId"] = StringValue(step, "stepId"),
+                ["elementId"] = elem.Id.IntegerValue,
+                ["uniqueId"] = elem.UniqueId,
+                ["category"] = elem.Category != null ? elem.Category.Name : "",
+                ["createdByPlan"] = createdByPlan
+            };
+        }
+
+        private static string ParameterText(Parameter p)
+        {
+            if (p == null) return "";
+            try
+            {
+                string value = p.AsValueString();
+                if (!string.IsNullOrEmpty(value)) return value;
+            }
+            catch { }
+            return ParameterRawText(p);
+        }
+
+        private static string ParameterRawText(Parameter p)
+        {
+            if (p == null || !p.HasValue) return "";
+            if (p.StorageType == StorageType.String) return p.AsString() ?? "";
+            if (p.StorageType == StorageType.Integer) return p.AsInteger().ToString(CultureInfo.InvariantCulture);
+            if (p.StorageType == StorageType.Double) return p.AsDouble().ToString(CultureInfo.InvariantCulture);
+            if (p.StorageType == StorageType.ElementId) return p.AsElementId().IntegerValue.ToString(CultureInfo.InvariantCulture);
+            return "";
+        }
+
+        private static XYZ PointValue(JObject obj, string unit)
+        {
+            if (obj == null)
+                throw new InvalidOperationException("Point/vector object is required.");
+            return new XYZ(
+                ConvertToInternal(DoubleValue(obj["x"]), unit),
+                ConvertToInternal(DoubleValue(obj["y"]), unit),
+                ConvertToInternal(DoubleValue(obj["z"]), unit));
+        }
+
+        private static double ConvertToInternal(double value, string unit)
+        {
+            string normalized = string.IsNullOrWhiteSpace(unit) ? "internal" : unit.Trim().ToLowerInvariant();
+            if (normalized == "mm" || normalized == "millimeter" || normalized == "millimeters")
+                return UnitUtils.ConvertToInternalUnits(value, UnitTypeId.Millimeters);
+            if (normalized == "cm" || normalized == "centimeter" || normalized == "centimeters")
+                return UnitUtils.ConvertToInternalUnits(value, UnitTypeId.Centimeters);
+            if (normalized == "m" || normalized == "meter" || normalized == "meters")
+                return UnitUtils.ConvertToInternalUnits(value, UnitTypeId.Meters);
+            return value;
+        }
+
+        private static int IntValue(JToken token)
+        {
+            if (token == null) return 0;
+            int value;
+            if (int.TryParse(token.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out value))
+                return value;
+            return 0;
+        }
+
+        private static byte ByteValue(JToken token)
+        {
+            int value = IntValue(token);
+            if (value < 0) value = 0;
+            if (value > 255) value = 255;
+            return (byte)value;
+        }
+
+        private static double DoubleValue(JToken token)
+        {
+            if (token == null) return 0.0;
+            double value;
+            if (double.TryParse(token.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value))
+                return value;
+            if (double.TryParse(token.ToString(), out value))
+                return value;
+            return 0.0;
+        }
+
+        private static string JTokenText(JToken token)
+        {
+            if (token == null || token.Type == JTokenType.Null) return "";
+            return token.ToString();
+        }
+
+        private static void CopyMessages(JArray source, JArray target)
+        {
+            if (source == null || target == null) return;
+            foreach (JToken item in source)
+                target.Add(item);
+        }
+    }
+}
