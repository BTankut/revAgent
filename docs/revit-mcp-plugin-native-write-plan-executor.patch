@@ -0,0 +1,52 @@
+using Autodesk.Revit.UI;
+using Newtonsoft.Json.Linq;
+using revit_mcp_sdk.API.Base;
+using revit_mcp_sdk.API.Models;
+using revit_mcp_sdk.Exceptions;
+using System;
+
+namespace SampleCommandSet.Commands.WritePlan
+{
+    public class ExecuteWritePlanCommand : ExternalEventCommandBase
+    {
+        private ExecuteWritePlanEventHandler _handler => (ExecuteWritePlanEventHandler)Handler;
+
+        public override string CommandName => "execute_write_plan";
+
+        public ExecuteWritePlanCommand(UIApplication uiApp)
+            : base(new ExecuteWritePlanEventHandler(), uiApp)
+        {
+        }
+
+        public override object Execute(JObject parameters, string requestId)
+        {
+            try
+            {
+                _handler.Mode = parameters != null && parameters["mode"] != null ? parameters["mode"].ToString() : "validate";
+                _handler.Plan = parameters != null && parameters["plan"] is JObject ? (JObject)parameters["plan"] : new JObject();
+                _handler.CommitToken = parameters != null && parameters["commitToken"] != null ? parameters["commitToken"].ToString() : "";
+                _handler.Reset();
+
+                if (!RaiseAndWaitForCompletion(120000))
+                    throw CreateTimeoutException(CommandName);
+
+                if (_handler.Exception != null)
+                    throw new CommandExecutionException(
+                        "execute_write_plan failed: " + _handler.Exception.Message,
+                        JsonRPCErrorCodes.InternalError);
+
+                return CommandResult.CreateSuccess(_handler.Result);
+            }
+            catch (CommandExecutionException)
+            {
+                throw;
+            }
+            catch (Exception ex)
+            {
+                throw new CommandExecutionException(
+                    "execute_write_plan failed: " + ex.Message,
+                    JsonRPCErrorCodes.InternalError);
+            }
+        }
+    }
+}
