+        private static void ValidateOperationPayload(JObject step, int index, JArray errors, JArray warnings)
+        {
+            string operation = StringValue(step, "operation");
+            if (operation != "create_schedule_or_update_schedule")
+                return;
+
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            if (string.IsNullOrWhiteSpace(StringValue(args, "scheduleName")))
+                errors.Add("steps[" + index + "].arguments.scheduleName is required");
+            bool hasScheduleId = args["scheduleId"] != null || ((step["targets"] as JObject) != null && (step["targets"] as JObject)["elementId"] != null);
+            bool hasCategory = args["categoryId"] != null || !string.IsNullOrWhiteSpace(StringValue(args, "category"));
+            if (!hasScheduleId && !hasCategory)
+                errors.Add("steps[" + index + "].arguments.category/categoryId or scheduleId/targets.elementId is required");
+            if (args["fields"] != null && !(args["fields"] is JArray))
+                errors.Add("steps[" + index + "].arguments.fields must be an array when provided");
+            JArray fields = args["fields"] as JArray;
+            if (args["fields"] == null || (fields != null && fields.Count == 0))
+                warnings.Add("steps[" + index + "].arguments.fields is empty; schedule will be created or renamed without adding fields");
+        }
