+        }
+    }
+}
diff --git a/SampleCommandSet/Commands/WritePlan/Validators/WritePlanValidator.cs b/SampleCommandSet/Commands/WritePlan/Validators/WritePlanValidator.cs
new file mode 100644
index 0000000..808db79
--- /dev/null
+++ b/SampleCommandSet/Commands/WritePlan/Validators/WritePlanValidator.cs
@@ -0,0 +1,120 @@
+using Newtonsoft.Json.Linq;
+using System.Collections.Generic;
+
+namespace SampleCommandSet.Commands.WritePlan.Validators
+{
+    public static class WritePlanValidator
+    {
+        private static readonly HashSet<string> SupportedModes = new HashSet<string>
+        {
+            "validate", "preview", "commit", "verify"
+        };
+
+        private static readonly HashSet<string> ImplementedOperations = new HashSet<string>
+        {
+            "set_parameter",
+            "clear_parameter",
+            "copy_parameter_value",
+            "change_type",
+            "view_hide_elements",
+            "view_unhide_elements",
+            "view_apply_overrides",
+            "place_family_instance",
+            "move_elements",
+            "create_duct_run",
+            "resize_duct",
+            "create_pipe_run",
+            "resize_pipe"
+        };
+
+        public static JObject Validate(string mode, JObject plan, string commitToken)
+        {
+            JArray errors = new JArray();
+            JArray warnings = new JArray();
+
+            if (!SupportedModes.Contains(mode))
+                errors.Add("mode must be validate, preview, commit, or verify");
+
+            if (plan == null)
+            {
+                errors.Add("plan is required");
+                return BuildResult(errors, warnings);
+            }
+
+            RequireString(plan, "schemaVersion", errors);
+            RequireString(plan, "planId", errors);
+            RequireString(plan, "title", errors);
+            RequireString(plan, "discipline", errors);
+            RequireString(plan, "riskLevel", errors);
+
+            if (plan["schemaVersion"] != null && plan["schemaVersion"].ToString() != "1.0")
+                errors.Add("schemaVersion must be 1.0");
+
+            JArray steps = plan["steps"] as JArray;
+            if (steps == null || steps.Count == 0)
+            {
+                errors.Add("steps must contain at least one step");
+            }
+            else
+            {
+                HashSet<string> stepIds = new HashSet<string>();
+                for (int i = 0; i < steps.Count; i++)
+                {
+                    JObject step = steps[i] as JObject;
+                    if (step == null)
+                    {
+                        errors.Add("steps[" + i + "] must be an object");
+                        continue;
+                    }
+                    string stepId = StringValue(step, "stepId");
+                    if (string.IsNullOrWhiteSpace(stepId))
+                        errors.Add("steps[" + i + "].stepId is required");
+                    else if (stepIds.Contains(stepId))
+                        errors.Add("steps[" + i + "].stepId is duplicated: " + stepId);
+                    else
+                        stepIds.Add(stepId);
+
+                    string operation = StringValue(step, "operation");
+                    if (string.IsNullOrWhiteSpace(operation))
+                        errors.Add("steps[" + i + "].operation is required");
+                    else if (!ImplementedOperations.Contains(operation))
+                        errors.Add("steps[" + i + "].operation is not implemented by the native executor: " + operation);
+
+                    if (!(step["targets"] is JObject))
+                        errors.Add("steps[" + i + "].targets must be an object");
+                    if (!(step["arguments"] is JObject))
+                        errors.Add("steps[" + i + "].arguments must be an object");
+                }
+            }
+
+            if (mode == "commit" && string.IsNullOrWhiteSpace(commitToken))
+                errors.Add("commit mode requires commitToken or explicit approval token");
+
+            return BuildResult(errors, warnings);
+        }
+
+        private static JObject BuildResult(JArray errors, JArray warnings)
+        {
+            return new JObject
+            {
+                ["valid"] = errors.Count == 0,
+                ["errors"] = errors,
+                ["warnings"] = warnings,
+                ["requiresOfficeStandard"] = false,
+                ["missingStandards"] = new JArray(),
+                ["canCommit"] = errors.Count == 0
+            };
+        }
+
+        private static void RequireString(JObject obj, string name, JArray errors)
+        {
+            if (string.IsNullOrWhiteSpace(StringValue(obj, name)))
+                errors.Add(name + " is required");
+        }
+
+        private static string StringValue(JObject obj, string name)
+        {
+            return obj[name] == null ? "" : obj[name].ToString();
+        }
+    }
+}
diff --git a/SampleCommandSet/Commands/WritePlan/Verification/WritePlanVerifier.cs b/SampleCommandSet/Commands/WritePlan/Verification/WritePlanVerifier.cs
new file mode 100644
index 0000000..e6d710d
--- /dev/null
+++ b/SampleCommandSet/Commands/WritePlan/Verification/WritePlanVerifier.cs
@@ -0,0 +1,50 @@
+using Autodesk.Revit.DB;
+using Newtonsoft.Json.Linq;
+using SampleCommandSet.Commands.WritePlan.Operations;
+
+namespace SampleCommandSet.Commands.WritePlan.Verification
+{
+    public static class WritePlanVerifier
+    {
+        public static JObject Verify(Document document, JObject plan)
+        {
+            JObject result = new JObject
+            {
+                ["success"] = true,
+                ["rows"] = new JArray(),
+                ["warnings"] = new JArray(),
+                ["errors"] = new JArray()
+            };
+
+            JArray rows = result["rows"] as JArray;
+            JArray warnings = result["warnings"] as JArray;
+            JArray errors = result["errors"] as JArray;
+            JArray steps = plan["steps"] as JArray;
+            if (steps == null) return result;
+
+            for (int i = 0; i < steps.Count; i++)
+            {
+                JObject step = steps[i] as JObject;
+                if (step == null) continue;
+                string operation = WritePlanExecutor.StringValue(step, "operation");
+                if (operation == "set_parameter")
+                {
+                    JObject row = WritePlanExecutor.VerifySetParameter(document, step);
+                    rows.Add(row);
+                    if (row["success"] != null && row["success"].Type == JTokenType.Boolean && !(bool)row["success"])
+                    {
+                        errors.Add(row["message"] != null ? row["message"].ToString() : "set_parameter verification failed");
+                    }
+                }
+                else
+                {
+                    warnings.Add("Verification is basic existence/readback only for operation: " + operation);
+                    rows.Add(WritePlanExecutor.BuildPreviewRow(document, plan, step));
+                }
+            }
+
+            result["success"] = errors.Count == 0;
+            return result;
+        }
+    }
+}
