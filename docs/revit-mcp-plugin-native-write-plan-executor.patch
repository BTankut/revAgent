diff --git a/SampleCommandSet/Commands/Test/SendCodeToRevitCommand.cs b/SampleCommandSet/Commands/Test/SendCodeToRevitCommand.cs
new file mode 100644
index 0000000..7d29e44
--- /dev/null
+++ b/SampleCommandSet/Commands/Test/SendCodeToRevitCommand.cs
@@ -0,0 +1,41 @@
+using Autodesk.Revit.UI;
+using Newtonsoft.Json.Linq;
+using revit_mcp_sdk.API.Base;
+using revit_mcp_sdk.API.Models;
+
+namespace SampleCommandSet.Commands.Test
+{
+    public class SendCodeToRevitCommand : ExternalEventCommandBase
+    {
+        private SendCodeToRevitEventHandler _handler => (SendCodeToRevitEventHandler)Handler;
+
+        public override string CommandName => "send_code_to_revit";
+
+        public SendCodeToRevitCommand(UIApplication uiApp)
+        : base(new SendCodeToRevitEventHandler(), uiApp)
+        {
+        }
+
+        public override object Execute(JObject parameters, string requestId)
+        {
+            _handler.Code = parameters["code"]?.ToString() ?? "";
+            if (parameters["parameters"] != null && parameters["parameters"] is JArray)
+            {
+                _handler.Parameters = (JArray)parameters["parameters"];
+            }
+            else
+            {
+                _handler.Parameters = new JArray();
+            }
+            
+            _handler.Reset();
+            RaiseAndWaitForCompletion(15000);
+            
+            if (_handler.Exception != null)
+            {
+                return CommandResult.CreateError(_handler.Exception.Message);
+            }
+            return CommandResult.CreateSuccess(new { result = _handler.Result });
+        }
+    }
+}
diff --git a/SampleCommandSet/Commands/Test/SendCodeToRevitEventHandler.cs b/SampleCommandSet/Commands/Test/SendCodeToRevitEventHandler.cs
new file mode 100644
index 0000000..c1fb7d0
--- /dev/null
+++ b/SampleCommandSet/Commands/Test/SendCodeToRevitEventHandler.cs
@@ -0,0 +1,110 @@
+using Autodesk.Revit.DB;
+using Autodesk.Revit.UI;
+using Newtonsoft.Json.Linq;
+using revit_mcp_sdk.API.Interfaces;
+using System;
+using System.CodeDom.Compiler;
+using System.Reflection;
+using System.Threading;
+using Microsoft.CSharp;
+
+namespace SampleCommandSet.Commands.Test
+{
+    public class SendCodeToRevitEventHandler : IExternalEventHandler, IWaitableExternalEventHandler
+    {
+        private readonly ManualResetEvent _resetEvent = new ManualResetEvent(false);
+
+        public string Code { get; set; }
+        public JArray Parameters { get; set; }
+        public Exception Exception { get; set; }
+        public object Result { get; set; }
+        
+        public void Reset()
+        {
+            _resetEvent.Reset();
+        }
+
+        public bool WaitForCompletion(int timeoutMilliseconds = 10000)
+        {
+            return _resetEvent.WaitOne(timeoutMilliseconds);
+        }
+
+        public void Execute(UIApplication app)
+        {
+            try
+            {
+                Exception = null;
+                Result = null;
+                
+                string sourceCode = @"
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Autodesk.Revit.DB;
+using Autodesk.Revit.UI;
+using Newtonsoft.Json.Linq;
+
+namespace RevitMcpDynamicCode
+{
+    public class DynamicExecutor
+    {
+        public object Execute(UIApplication uiApp, JArray parameters)
+        {
+            Document doc = uiApp.ActiveUIDocument.Document;
+            " + Code + @"
+            return null;
+        }
+    }
+}";
+
+                CSharpCodeProvider provider = new CSharpCodeProvider();
+                CompilerParameters compilerParams = new CompilerParameters
+                {
+                    GenerateInMemory = true,
+                    GenerateExecutable = false
+                };
+
+                compilerParams.ReferencedAssemblies.Add("System.dll");
+                compilerParams.ReferencedAssemblies.Add("System.Core.dll");
+                compilerParams.ReferencedAssemblies.Add("System.Data.dll");
+                compilerParams.ReferencedAssemblies.Add("System.Xml.dll");
+                compilerParams.ReferencedAssemblies.Add("System.Xml.Linq.dll");
+                
+                compilerParams.ReferencedAssemblies.Add(typeof(Document).Assembly.Location);
+                compilerParams.ReferencedAssemblies.Add(typeof(UIApplication).Assembly.Location);
+                compilerParams.ReferencedAssemblies.Add(typeof(JObject).Assembly.Location);
+
+                CompilerResults results = provider.CompileAssemblyFromSource(compilerParams, sourceCode);
+
+                if (results.Errors.HasErrors)
+                {
+                    string errors = "";
+                    foreach (CompilerError error in results.Errors)
+                    {
+                        errors += error.ErrorText + "\n";
+                    }
+                    throw new Exception("Compilation failed: \n" + errors);
+                }
+
+                Type type = results.CompiledAssembly.GetType("RevitMcpDynamicCode.DynamicExecutor");
+                object instance = Activator.CreateInstance(type);
+                MethodInfo method = type.GetMethod("Execute");
+                
+                Result = method.Invoke(instance, new object[] { app, Parameters });
+            }
+            catch (Exception ex)
+            {
+                Exception = ex;
+            }
+            finally
+            {
+                _resetEvent.Set();
+            }
+        }
+
+        public string GetName()
+        {
+            return "send_code_to_revit";
+        }
+    }
+}
diff --git a/SampleCommandSet/Commands/WritePlan/ExecuteWritePlanCommand.cs b/SampleCommandSet/Commands/WritePlan/ExecuteWritePlanCommand.cs
