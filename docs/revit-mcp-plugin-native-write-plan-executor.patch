+        private static bool TryConnectNearestConnectorPair(Element first, Element second, double tolerance, JArray failures, string context)
+        {
+            Connector firstConnector;
+            Connector secondConnector;
+            double distance;
+            FindNearestConnectorPair(first, second, out firstConnector, out secondConnector, out distance);
+            if (firstConnector == null || secondConnector == null || distance > tolerance)
+            {
+                failures.Add(new JObject
+                {
+                    ["context"] = context,
+                    ["message"] = "Nearest connector pair not found within tolerance",
+                    ["distance"] = distance
+                });
+                return false;
+            }
+            return TryConnectConnectors(firstConnector, secondConnector, failures, context);
+        }
