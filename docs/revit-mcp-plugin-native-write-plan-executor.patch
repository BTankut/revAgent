+        private static bool AreNearestConnectorPairConnected(Element first, Element second, double tolerance)
+        {
+            Connector firstConnector;
+            Connector secondConnector;
+            double distance;
+            FindNearestConnectorPair(first, second, out firstConnector, out secondConnector, out distance);
+            if (firstConnector == null || secondConnector == null || distance > tolerance)
+                return false;
+            return SafeIsConnectedTo(firstConnector, secondConnector);
+        }
+
+        private static void FindNearestConnectorPair(Element first, Element second, out Connector firstConnector, out Connector secondConnector, out double distance)
+        {
+            firstConnector = null;
+            secondConnector = null;
+            distance = double.MaxValue;
+            foreach (Connector a in ElementConnectors(first))
+            {
+                XYZ aOrigin = SafeConnectorOrigin(a);
+                foreach (Connector b in ElementConnectors(second))
+                {
+                    XYZ bOrigin = SafeConnectorOrigin(b);
+                    double current = aOrigin.DistanceTo(bOrigin);
+                    if (current < distance)
+                    {
+                        distance = current;
+                        firstConnector = a;
+                        secondConnector = b;
+                    }
+                }
+            }
+        }
