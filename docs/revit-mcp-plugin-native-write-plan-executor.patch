+{
+    public static class WritePlanPreviewBuilder
+    {
+        public static JArray Build(Document document, JObject plan)
+        {
+            JArray rows = new JArray();
+            JArray steps = plan["steps"] as JArray;
+            if (steps == null) return rows;
