+        private static int VerifyRerouteClearance(Document document, ICollection<ElementId> ids, JObject args, JArray checks)
+        {
+            JArray obstacleBoxes = args["obstacleBoxes"] as JArray ?? args["obstacles"] as JArray;
+            if (obstacleBoxes == null || obstacleBoxes.Count == 0)
+                return 0;
+            string unit = StringValue(args, "unit");
+            double clearanceInternal = ClearanceInternal(args, unit);
+            List<RouteBox> boxes = new List<RouteBox>();
+            foreach (JToken token in obstacleBoxes)
+            {
+                RouteBox box = RouteBoxValue(token as JObject, unit, clearanceInternal);
+                if (box != null) boxes.Add(box);
+            }
+            int violationCount = 0;
+            foreach (ElementId id in ids)
+            {
+                Element elem = document.GetElement(id);
+                LocationCurve location = elem != null ? elem.Location as LocationCurve : null;
+                Curve curve = location != null ? location.Curve : null;
+                XYZ start = null;
+                XYZ end = null;
+                if (curve != null)
+                {
+                    try
+                    {
+                        start = curve.GetEndPoint(0);
+                        end = curve.GetEndPoint(1);
+                    }
+                    catch { }
+                }
+                for (int i = 0; i < boxes.Count; i++)
+                {
+                    bool violates = start != null && end != null && SegmentIntersectsBox(start, end, boxes[i]);
+                    if (violates) violationCount++;
+                    checks.Add(new JObject
+                    {
+                        ["elementId"] = id.IntegerValue,
+                        ["obstacleIndex"] = i,
+                        ["intersectsExpandedObstacle"] = violates
+                    });
+                }
+            }
+            return violationCount;
+        }
+
+        private static double ClearanceInternal(JObject args, string unit)
+        {
+            if (args["clearanceM"] != null)
+                return Math.Max(0.0, ConvertToInternal(DoubleValue(args["clearanceM"]), "m"));
+            if (args["clearance"] != null)
+                return Math.Max(0.0, ConvertToInternal(DoubleValue(args["clearance"]), unit));
+            return 0.0;
+        }
+
+        private static RouteBox RouteBoxValue(JObject obj, string unit, double clearanceInternal)
+        {
+            if (obj == null) return null;
+            JObject minObj = obj["min"] as JObject;
+            JObject maxObj = obj["max"] as JObject;
+            if (minObj == null || maxObj == null) return null;
+            XYZ minPoint = PointValue(minObj, unit);
+            XYZ maxPoint = PointValue(maxObj, unit);
+            return new RouteBox
+            {
+                MinX = Math.Min(minPoint.X, maxPoint.X) - clearanceInternal,
+                MinY = Math.Min(minPoint.Y, maxPoint.Y) - clearanceInternal,
+                MinZ = Math.Min(minPoint.Z, maxPoint.Z) - clearanceInternal,
+                MaxX = Math.Max(minPoint.X, maxPoint.X) + clearanceInternal,
+                MaxY = Math.Max(minPoint.Y, maxPoint.Y) + clearanceInternal,
+                MaxZ = Math.Max(minPoint.Z, maxPoint.Z) + clearanceInternal
+            };
+        }
+
+        private static bool SegmentIntersectsBox(XYZ start, XYZ end, RouteBox box)
+        {
+            double tMin = 0.0;
+            double tMax = 1.0;
+            if (!ClipSegmentAxis(start.X, end.X, box.MinX, box.MaxX, ref tMin, ref tMax)) return false;
+            if (!ClipSegmentAxis(start.Y, end.Y, box.MinY, box.MaxY, ref tMin, ref tMax)) return false;
+            if (!ClipSegmentAxis(start.Z, end.Z, box.MinZ, box.MaxZ, ref tMin, ref tMax)) return false;
+            return true;
+        }
+
+        private static bool ClipSegmentAxis(double start, double end, double min, double max, ref double tMin, ref double tMax)
+        {
+            double delta = end - start;
+            if (Math.Abs(delta) < 1e-9)
+                return start >= min && start <= max;
+            double t1 = (min - start) / delta;
+            double t2 = (max - start) / delta;
+            if (t1 > t2)
+            {
+                double temp = t1;
+                t1 = t2;
+                t2 = temp;
+            }
+            if (t1 > tMin) tMin = t1;
+            if (t2 < tMax) tMax = t2;
+            return tMin <= tMax;
+        }
+
         private static double ConvertToInternal(double value, string unit)
