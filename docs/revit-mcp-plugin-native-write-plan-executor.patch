+        private static bool TryConnectConnectors(Connector first, Connector second, JArray failures, string context)
+        {
+            if (first == null || second == null)
+            {
+                failures.Add(new JObject { ["context"] = context, ["message"] = "Connector not found" });
+                return false;
+            }
+            try
+            {
+                if (first.Owner != null && second.Owner != null && first.Owner.Id.IntegerValue == second.Owner.Id.IntegerValue)
+                {
+                    failures.Add(new JObject { ["context"] = context, ["message"] = "Cannot connect connectors on the same owner" });
+                    return false;
+                }
+                if (SafeIsConnectedTo(first, second))
+                    return true;
+                first.ConnectTo(second);
+                return SafeIsConnectedTo(first, second);
+            }
+            catch (Exception ex)
+            {
+                failures.Add(new JObject
+                {
+                    ["context"] = context,
+                    ["message"] = ex.Message
+                });
+                return false;
+            }
+        }
