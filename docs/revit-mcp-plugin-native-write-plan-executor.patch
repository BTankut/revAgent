+        private static JObject VerifyStep(Document document, JObject plan, JObject step)
+        {
+            string operation = WritePlanExecutor.StringValue(step, "operation");
+            if (operation == "set_parameter")
+                return WritePlanExecutor.VerifySetParameter(document, step);
+            if (operation == "clear_parameter")
+                return VerifyClearParameter(document, step);
+            if (operation == "change_type")
+                return VerifyChangeType(document, step);
+            if (operation == "resize_duct" || operation == "resize_pipe")
+                return VerifyResize(document, step, operation);
+            if (operation == "view_hide_elements")
+                return VerifyViewHidden(document, step, true);
+            if (operation == "view_unhide_elements")
+                return VerifyViewHidden(document, step, false);
+            return VerifyTargetExists(document, plan, step);
+        }
