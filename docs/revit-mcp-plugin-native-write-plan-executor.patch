+                        int ownerId = owner.Id.IntegerValue;
+                        if (routeOwnerIds.Contains(ownerId)) continue;
+                        if (!IsRouteFittingReferenceOwner(owner)) continue;
+                        string key = routeId.IntegerValue.ToString(CultureInfo.InvariantCulture) + ":" + ownerId.ToString(CultureInfo.InvariantCulture);
+                        if (seen.Contains(key)) continue;
+                        seen.Add(key);
+                        count++;
+                        refs.Add(new JObject
+                        {
