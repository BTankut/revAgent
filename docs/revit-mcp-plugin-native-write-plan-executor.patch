+                });
+            }
+            return count;
+        }
+
+        private static bool IsSystemReferenceOwner(Element owner)
+        {
+            if (owner == null) return false;
+            string category = owner.Category != null ? owner.Category.Name : "";
+            if (category.EndsWith(" Systems", StringComparison.OrdinalIgnoreCase)) return true;
+            if (category.EndsWith("Systems", StringComparison.OrdinalIgnoreCase)) return true;
+            return false;
+        }
