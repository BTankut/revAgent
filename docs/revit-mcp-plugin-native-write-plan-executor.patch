+        private static JObject VerifyStep(Document document, JObject plan, JObject step)
+        {
+            string operation = WritePlanExecutor.StringValue(step, "operation");
+            if (operation == "set_parameter")
+                return WritePlanExecutor.VerifySetParameter(document, step);
+            if (operation == "clear_parameter")
+                return VerifyClearParameter(document, step);
+            if (operation == "change_type")
+                return VerifyChangeType(document, step);
+            if (operation == "resize_duct" || operation == "resize_pipe")
+                return VerifyResize(document, step, operation);
+            if (operation == "view_hide_elements")
+                return VerifyViewHidden(document, step, true);
+            if (operation == "view_unhide_elements")
+                return VerifyViewHidden(document, step, false);
+            return VerifyTargetExists(document, plan, step);
+        }
+
+        private static JObject VerifyClearParameter(Document document, JObject step)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = TargetElement(document, step);
+            Parameter p = elem != null ? elem.LookupParameter(WritePlanExecutor.StringValue(args, "parameterName")) : null;
+            string actual = ParameterRawText(p);
+            bool ok = p != null && string.IsNullOrEmpty(actual);
+            return new JObject
+            {
+                ["success"] = ok,
+                ["stepId"] = WritePlanExecutor.StringValue(step, "stepId"),
+                ["operation"] = "clear_parameter",
+                ["parameterName"] = WritePlanExecutor.StringValue(args, "parameterName"),
+                ["expected"] = "",
+                ["actual"] = actual,
+                ["message"] = ok ? "verified" : "parameter value is not cleared"
+            };
+        }
+
+        private static JObject VerifyChangeType(Document document, JObject step)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = TargetElement(document, step);
+            int expected = IntValue(args["typeId"]);
+            int actual = elem != null && elem.GetTypeId() != null ? elem.GetTypeId().IntegerValue : 0;
+            bool ok = elem != null && actual == expected;
+            return new JObject
+            {
+                ["success"] = ok,
+                ["stepId"] = WritePlanExecutor.StringValue(step, "stepId"),
+                ["operation"] = "change_type",
+                ["expectedTypeId"] = expected,
+                ["actualTypeId"] = actual,
+                ["message"] = ok ? "verified" : "type id does not match expected value"
+            };
+        }
+
+        private static JObject VerifyResize(Document document, JObject step, string operation)
+        {
+            JObject args = step["arguments"] as JObject ?? new JObject();
+            Element elem = TargetElement(document, step);
+            JArray checks = new JArray();
+            bool ok = elem != null;
+            if (elem == null)
+                ok = false;
+            if (args["width"] != null)
+                ok = VerifyDoubleParameter(elem, "Width", args["width"], WritePlanExecutor.StringValue(args, "unit"), checks) && ok;
+            if (args["height"] != null)
+                ok = VerifyDoubleParameter(elem, "Height", args["height"], WritePlanExecutor.StringValue(args, "unit"), checks) && ok;
+            if (args["diameter"] != null)
+                ok = VerifyDoubleParameter(elem, "Diameter", args["diameter"], WritePlanExecutor.StringValue(args, "unit"), checks) && ok;
